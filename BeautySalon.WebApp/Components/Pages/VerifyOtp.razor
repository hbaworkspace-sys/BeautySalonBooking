    private async Task SelectUser(UserDto selectedUser)
    {
        if (_isSelectingUser) return;

        _isSelectingUser = true;
        _otpError = null;
        StateHasChanged();

        try
        {
            Console.WriteLine($"👤 Selecting user: {selectedUser.FirstName} (ID: {selectedUser.Id})");

            // پیدا کردن توکن مربوط به کاربر انتخاب شده
            var authResult = _loginResponse?.ListPayload?.FirstOrDefault(x => x.User?.Id == selectedUser.Id);

            if (authResult?.Tokens != null)
            {
                // ذخیره توکن کاربر انتخاب شده
                await TokenService.SetTokensAsync(authResult.Tokens, authResult.User);

                _showUserSelection = false;
                _isOtpVerified = true;

                Console.WriteLine($"✅ User selected: {selectedUser.FirstName} (Role: {RoleHelper.GetRoleName(selectedUser.AuthenticationType)})");

                // پاک کردن Session
                if (!string.IsNullOrEmpty(SessionId))
                {
                    MemoryCache.Remove(SessionId);
                }

                // رفتن به داشبورد
                Navigation.NavigateTo("/dashboard", true);
            }
            else
            {
                _otpError = "خطا در دریافت توکن کاربر. مجدداً تلاش کنید.";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _otpError = "خطا در انتخاب کاربر";
            Console.WriteLine($"❌ Error selecting user: {ex.Message}");
            StateHasChanged();
        }
        finally
        {
            _isSelectingUser = false;
        }
    }
    private void CancelUserSelection()
    {
        _showUserSelection = false;
        _allUsers.Clear();
        _loginResponse = null;
        ResetOtpFields();
        StateHasChanged();
    }
    private void ResetOtpFields()
    {
        _otpDigits = new string[6];
        _isOtpComplete = false;
        StateHasChanged();

        // فوکوس روی اولین فیلد
        _ = JSRuntime.InvokeVoidAsync("eval", "document.getElementById('otp-0').focus();");
    }
    private async Task SaveAuthTokens(TokenResponse token, UserDto? user)
    {
        try
        {
            // ذخیره توکن‌ها با متد جدید

            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "accessToken", token.AccessToken);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "refreshToken", token.RefreshToken);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "tokenExpiry", token.ExpiresAt.ToString("O"));

            if (user != null)
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "user", System.Text.Json.JsonSerializer.Serialize(user));
            }

            Console.WriteLine("✅ Tokens saved successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error saving tokens: {ex.Message}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/login");
    }

    private async Task ResendOtp()
    {
        if (_isResendDisabled) return;

        try
        {
            var request = new LoginInitiateRequest
                {
                    MobileNumber = _mobileForApi ?? ""
                };

            var response = await AuthService.RequestLoginOtpAsync(request);

            if (response.IsSuccess)
            {

                if (response.IsSuccess)
                {
                    var sessionId = Guid.NewGuid().ToString();

                    // ذخیره اطلاعات در MemoryCache
                    var otpData = new OtpData
                        {
                            Phone = request.MobileNumber,
                            Otp = "",
                            CreatedAt = DateTime.UtcNow
                        };

                    MemoryCache.Set(sessionId, otpData, TimeSpan.FromMinutes(5));





                    Navigation.NavigateTo($"/verify-otp?sessionId={sessionId}", true);

                }
                else
                {
                    _otpError = null;
                    _otpDigits = new string[6];
                    _isOtpComplete = false;
                    StateHasChanged();

                    await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('otp-0').focus();");
                    StartResendTimer();
                }
            }
            else
            {
                _otpError = response.Message ?? "خطا در ارسال مجدد کد";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error in ResendOtp: {ex.Message}");
            _otpError = "خطا در ارسال مجدد کد";
            StateHasChanged();
        }
    }

    private void StartResendTimer()
    {
        _isResendDisabled = true;
        _resendTimer = 60;

        _timer?.Dispose();
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (sender, e) =>
        {
            _resendTimer--;
            if (_resendTimer <= 0)
            {
                _timer.Stop();
                _isResendDisabled = false;
            }
            InvokeAsync(StateHasChanged);
        };
        _timer.Start();
    }

    private string FormatPhoneNumber(string phone)
    {
        if (string.IsNullOrEmpty(phone)) return "۰۹۱۲XXXXXXX";

        if (!phone.StartsWith('0'))
        {
            phone = "0" + phone;
        }

        if (phone.Length >= 11)
        {
            return $"{phone[..4]} {phone[4..7]} {phone[7..]}";
        }

        return phone;
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
