@page "/verify-otp"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILoginService AuthService
@using BeautySalonBooking.Contracts.Authentication.Dtos
@using BeautySalonBooking.Contracts.Authentication.Requests
@using BeautySalonBooking.Contracts.Authentication.Responses
@using BeautySalonBooking.Contracts.Common
@using BeautySalonBooking.WebApp.Interfaces
@using BeautySalonBooking.WebApp.Interfaces.Common
@using BeautySalonBooking.WebApp.Interfaces.Login
@using BeautySalonBooking.WebApp.Models
@using BeautySalonBooking.WebApp.Services
@using Microsoft.Extensions.Caching.Memory
@inject IMemoryCache MemoryCache
@using BeautySalonBooking.WebApp.Helpers
@inject ITokenService TokenService
@using BeautySalonBooking.WebApp.Authentication
@inject CustomAuthenticationStateProvider _authProvider
<PageTitle>تایید کد | بیوتی سالن</PageTitle>

<main class="login-page beauty-login" dir="rtl">
    <section class="login-visual">
        <div class="visual-glow glow-one"></div>
        <div class="visual-glow glow-two"></div>
        <div class="visual-content">
            <span class="eyebrow">سامانه مدیریت آرایشگاه</span>
            <h1>تایید هویت<br />با کد پیامک شده</h1>
            <p>کد ۶ رقمی ارسال شده به شماره موبایل خود را وارد کنید.</p>
            <div class="dashboard-card" style="padding: 20px;">
                <div style="display: flex; justify-content: center; align-items: center; gap: 8px; font-size: 14px; color: #714553;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.574 2.81.7A2 2 0 0 1 22 16.92z" />
                    </svg>
                    <span style="direction:ltr">@_phoneNumber</span>
                </div>
            </div>
        </div>
        <p class="visual-footer">© ۲۰۲۶ بیوتی سالن. همه حقوق محفوظ است.</p>
    </section>

    <section class="login-panel">
        <div class="form-wrap">
            <div class="login-identity" style="margin-bottom: 20px;">
                <img src="images/salon-logo.png" alt="لوگوی بیوتی سالن" style="width: 50px; height: 50px;" />
                <div>
                    <h1 style="font-size: 20px;">تایید کد</h1>
                    <p style="font-size: 12px;">کد ۶ رقمی را وارد کنید</p>
                </div>
            </div>

            <div style="text-align: center; margin-bottom: 30px;">
                <p style="color: #ad8992; font-size: 13px;">کد تایید به شماره</p>
                <p style="color: #714553; font-weight: 600; font-size: 16px; direction: ltr;">@_phoneNumber</p>
                <p style="color: #ad8992; font-size: 12px;">ارسال شد</p>
            </div>

            <div class="otp-container" style="display: flex; gap: 10px; justify-content: center; direction: ltr; margin-bottom: 20px;">
                @for (int i = 0; i < 6; i++)
                {
                    var index = i;
                    <input type="text"
                           class="otp-input @(_isOtpComplete ? "success" : "")"
                           id="otp-@index"
                           maxlength="1"
                           inputmode="numeric"
                           pattern="[0-9]"
                           value="@_otpDigits[index]"
                           @oninput="(e) => OnOtpInput(index, e)"
                           @onkeydown="(e) => OnOtpKeyDown(index, e)"
                           @onfocus="() => OnOtpFocus(index)"
                           @onclick="() => OnOtpClick(index)"
                           autofocus="@(index == 0)"
                           disabled="@_showUserSelection" />  <!-- ✅ اضافه کن -->
                }
            </div>

            <div style="text-align: center; margin-bottom: 15px;">
                @if (!string.IsNullOrEmpty(_otpError))
                {
                    <span class="validation-message" style="color: #dc3545; font-size: 13px;">@_otpError</span>
                }
                @if (_isOtpVerified)
                {
                    <span style="color: #28a745; font-size: 13px;">✓ کد تایید معتبر است</span>
                }
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px; max-width: 300px; margin: 0 auto;">
                <button class="submit-button" type="button" @onclick="HandleVerifyOtp" disabled="@(!_isOtpComplete || _isVerifying || _showUserSelection)">
                    @if (_isVerifying)
                    {
                        <span>در حال تایید...</span>
                    }
                    else
                    {
                        <span>تایید و ورود <span>←</span></span>
                    }
                </button>

                <div style="display: flex; justify-content: center; align-items: center; gap: 16px;">
                    <button type="button" @onclick="GoBack" style="background: none; border: none; color: #ab939a; font-size: 13px; cursor: pointer; text-decoration: underline;">
                        ← بازگشت
                    </button>
                    <span style="color: #ab939a; font-size: 12px;">|</span>
                    <button type="button" @onclick="ResendOtp" disabled="@_isResendDisabled || _showUserSelection" style="background: none; border: none; color: #d26b7d; font-size: 13px; cursor: pointer; @(_isResendDisabled ? "opacity: 0.5;" : "")">
                        @if (_isResendDisabled)
                        {
                            <span>ارسال مجدد (@_resendTimer ثانیه)</span>
                        }
                        else
                        {
                            <span>ارسال مجدد کد</span>
                        }
                    </button>
                </div>
            </div>

            <p class="login-help" style="margin-top: 30px;">در صورت نداشتن دسترسی، با مدیر سیستم تماس بگیرید.</p>
        </div>
    </section>
</main>
<!-- ========== مودال انتخاب کاربر ========== -->
@if (_showUserSelection && _allUsers.Any())
{
    <div class="modal-overlay" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 9999; backdrop-filter: blur(4px);">
        <div class="modal-content" style="background: white; border-radius: 20px; padding: 40px; max-width: 500px; width: 90%; max-height: 80vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.3); animation: slideUp 0.3s ease-out;">

            <!-- هدر مودال -->
            <div style="text-align: center; margin-bottom: 25px;">
                <div style="width: 60px; height: 60px; background: #f8f0f2; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px;">
                    <span style="font-size: 30px;">👤</span>
                </div>
                <h3 style="color: #2d1b20; font-size: 20px; margin: 0;">انتخاب نقش کاربری</h3>
                <p style="color: #ad8992; font-size: 14px; margin-top: 8px;">
                    چندین نقش با این شماره یافت شد. لطفاً یکی را انتخاب کنید:
                </p>
            </div>

            <!-- لیست کاربران -->
            <div style="display: flex; flex-direction: column; gap: 12px;">
                @foreach (var user in _allUsers)
                {
                    var roleName = RoleHelper.GetRoleName(user.AuthenticationType);
                    var roleColor = RoleHelper.GetRoleColor(user.AuthenticationType);
                    var roleIcon = RoleHelper.GetRoleIcon(user.AuthenticationType);
                    var roleDesc = RoleHelper.GetRoleDescription(user.AuthenticationType);

                    <button class="user-select-btn"
                            @onclick="() => SelectUser(user)"
                            disabled="@_isSelectingUser"
                            style="display: flex; align-items: center; gap: 15px; padding: 15px 20px; border: 2px solid #e8dce0; border-radius: 12px; background: white; cursor: pointer; transition: all 0.2s; width: 100%; text-align: right; @( _isSelectingUser ? "opacity: 0.6; cursor: not-allowed;" : "" )"
                            onmouseover="this.style.borderColor='#d26b7d'; this.style.backgroundColor='#fcf6f8';"
                            onmouseout="this.style.borderColor='#e8dce0'; this.style.backgroundColor='white';">

                        <!-- آواتار کاربر -->
                        <div style="width: 44px; height: 44px; border-radius: 50%; background: @(roleColor + "20"); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <span style="font-size: 20px; color: @roleColor;">
                                @roleIcon
                            </span>
                        </div>

                        <!-- اطلاعات کاربر -->
                        <div style="flex: 1; text-align: right;">
                            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                <strong style="color: #2d1b20; font-size: 16px;">
                                    @(!string.IsNullOrEmpty(user.FirstName) ? $"{user.FirstName} {user.LastName}" : user.UserName)
                                </strong>
                                <span class="badge" style="background: @roleColor; color: white; padding: 2px 10px; border-radius: 20px; font-size: 11px; font-weight: 500;">
                                    @user.Roles.FirstOrDefault()
                                </span>
                            </div>
                            <div style="color: #ad8992; font-size: 12px; margin-top: 4px;">
                                @roleDesc
                            </div>
                            <div style="color: #ad8992; font-size: 11px; margin-top: 2px; direction:ltr">
                                @(!string.IsNullOrEmpty(user.PhoneNumber) ? FormatPhoneNumber(user.PhoneNumber) : "شماره نامشخص")
                            </div>
                        </div>

                        <!-- آیکون فلش -->
                        <div style="color: #d26b7d; font-size: 18px; flex-shrink: 0;">
                            ←
                        </div>
                    </button>
                }
            </div>

            <!-- دکمه انصراف -->
            <div style="text-align: center; margin-top: 20px;">
                <button @onclick="CancelUserSelection"
                        style="background: none; border: none; color: #ab939a; font-size: 13px; cursor: pointer; text-decoration: underline;">
                    انصراف و بازگشت
                </button>
            </div>
        </div>
    </div>
}

<!-- استایل‌های انیمیشن -->
<style>
    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px) scale(0.95);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .user-select-btn:hover {
        transform: translateX(-3px);
        box-shadow: 0 4px 15px rgba(210, 107, 125, 0.15);
    }

    .otp-input:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>
@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string SessionId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Mobile { get; set; }

    private string[] _otpDigits = new string[6];
    private string? _otpError;
    private bool _isOtpVerified = false;
    private bool _isOtpComplete = false;
    private bool _isVerifying = false;
    private bool _isResendDisabled = false;
    private int _resendTimer = 60;
    private System.Timers.Timer? _timer;
    private string _phoneNumber = string.Empty;
    private string? _mobileForApi;

    // ========== متغیرهای چند کاربر ==========
    private List<UserDto> _allUsers = new();
    private bool _showUserSelection = false;
    private bool _isSelectingUser = false;
    private ApiResponse_New<AuthResult>? _loginResponse;

    protected override void OnInitialized()
    {
        try
        {
            if (!string.IsNullOrEmpty(SessionId) && MemoryCache.TryGetValue(SessionId, out OtpData? data))
            {
                _phoneNumber = FormatPhoneNumber(data?.Phone ?? "");
                _mobileForApi = data?.Phone ?? "";
                Console.WriteLine($"✅ Session found: Phone={_phoneNumber}, MobileForApi={_mobileForApi}");
            }
            else if (!string.IsNullOrEmpty(Mobile))
            {
                _mobileForApi = Mobile;
                _phoneNumber = FormatPhoneNumber(Mobile);
                Console.WriteLine($"✅ Using mobile from query: {_mobileForApi}");
            }
            else
            {
                Console.WriteLine($"❌ Session or Mobile not found");
                _otpError = "اطلاعات ورودی نامعتبر است";
                Navigation.NavigateTo("/login");
                return;
            }

            _otpDigits = new string[6];
            UpdateOtpStatus();
            StartResendTimer();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error in OnInitialized: {ex.Message}");
            _otpError = "خطا در بارگذاری صفحه";
        }
    }

    private async Task OnOtpInput(int index, ChangeEventArgs e)
    {
        try
        {
            var value = e.Value?.ToString() ?? "";

            if (string.IsNullOrEmpty(value))
            {
                _otpDigits[index] = "";
                UpdateOtpStatus();
                StateHasChanged();
                return;
            }

            var firstChar = value[0];

            if (char.IsDigit(firstChar))
            {
                _otpDigits[index] = firstChar.ToString();

                if (index < 5)
                {
                    await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('otp-{index + 1}').focus();");
                }
            }
            else
            {
                _otpDigits[index] = "";
            }

            UpdateOtpStatus();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error in OnOtpInput: {ex.Message}");
        }
    }

    private async Task OnOtpKeyDown(int index, KeyboardEventArgs e)
    {
        try
        {
            if (e.Key == "Backspace")
            {
                if (string.IsNullOrEmpty(_otpDigits[index]) && index > 0)
                {
                    await JSRuntime.InvokeVoidAsync("eval",
                        $"document.getElementById('otp-{index - 1}').focus(); document.getElementById('otp-{index - 1}').select();");
                }
                else if (!string.IsNullOrEmpty(_otpDigits[index]))
                {
                    _otpDigits[index] = "";
                    UpdateOtpStatus();
                    StateHasChanged();
                }
            }

            if (e.Key == "Delete" && !string.IsNullOrEmpty(_otpDigits[index]))
            {
                _otpDigits[index] = "";
                UpdateOtpStatus();
                StateHasChanged();
            }

            if (e.Key == "ArrowLeft" && index > 0)
            {
                await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('otp-{index - 1}').focus();");
            }

            if (e.Key == "ArrowRight" && index < 5)
            {
                await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('otp-{index + 1}').focus();");
            }

            if (e.Key == "Enter" && _isOtpComplete)
            {
                await HandleVerifyOtp();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error in OnOtpKeyDown: {ex.Message}");
        }
    }

    private async Task OnOtpFocus(int index)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('otp-{index}').select();");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error in OnOtpFocus: {ex.Message}");
        }
    }

    private async Task OnOtpClick(int index)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('otp-{index}').select();");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error in OnOtpClick: {ex.Message}");
        }
    }

    private void UpdateOtpStatus()
    {
        var allFilled = true;
        var allDigits = true;

        for (int i = 0; i < 6; i++)
        {
            if (string.IsNullOrEmpty(_otpDigits[i]))
            {
                allFilled = false;
                break;
            }
            if (!char.IsDigit(_otpDigits[i][0]))
            {
                allDigits = false;
                break;
            }
        }

        _isOtpComplete = allFilled && allDigits;
        _otpError = null;
    }

    private async Task HandleVerifyOtp()
    {
        if (!_isOtpComplete) return;

        _isVerifying = true;
        _otpError = null;
        StateHasChanged();

        try
        {
            var enteredOtp = string.Join("", _otpDigits);
            Console.WriteLine($"🔍 Verifying OTP: {enteredOtp} for mobile: {_mobileForApi}");

            var request = new VerifyOtpRequest
                {
                    MobileNumber = _mobileForApi ?? "",
                    OtpCode = enteredOtp
                };

            var response = await AuthService.VerifyLoginOtpAsync(request);

            if (response.IsSuccess)
            {
                // ========== حالت 1: یک کاربر ==========
                if (response.Payload?.Tokens != null)
                {
                    _isOtpVerified = true;
                    Console.WriteLine("✅ Single user login successful");

                    // پاک کردن Session
                    if (!string.IsNullOrEmpty(SessionId))
                    {
                        MemoryCache.Remove(SessionId);
                    }

                    // رفتن به داشبورد
                    Navigation.NavigateTo("/dashboard", true);
                }
                // ========== حالت 2: چند کاربر ==========
                else if (response.ListPayload != null && response.ListPayload.Any())
                {
                    _loginResponse = response;
                    _allUsers = response.ListPayload.Select(x => x.User).ToList();

                    // اگر فقط یک کاربر در لیست هست
                    if (_allUsers.Count == 1)
                    {
                        var singleUser = response.ListPayload.First();
                        await TokenService.SetTokensAsync(
     singleUser.Tokens,
     singleUser.User);


                        _authProvider.NotifyUserAuthentication(
                            singleUser.Tokens.AccessToken);


                        if (!string.IsNullOrEmpty(SessionId))
                        {
                            MemoryCache.Remove(SessionId);
                        }

                        Navigation.NavigateTo("/dashboard", true);
                    }
                    else
                    {
                        // نمایش مودال انتخاب کاربر
                        _showUserSelection = true;
                        _isOtpVerified = false;
                        Console.WriteLine($"⚠️ Multiple users found: {_allUsers.Count}");
                        StateHasChanged();
                    }
                }
                else
                {
                    _otpError = "پاسخ نامعتبر از سرور";
                    _isOtpVerified = false;
                }
            }
            else
            {
                _otpError = response.Message ?? "کد وارد شده نادرست است. مجدداً تلاش کنید.";
                _isOtpVerified = false;
                ResetOtpFields();
            }
        }
        catch (Exception ex)
        {
            _otpError = "خطا در تایید کد. لطفاً مجدداً تلاش کنید.";
            Console.WriteLine($"❌ Error in HandleVerifyOtp: {ex.Message}");
        }
        finally
        {
            _isVerifying = false;
            StateHasChanged();
        }
    }
