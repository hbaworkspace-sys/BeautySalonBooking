@page "/login"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@using BeautySalonBooking.Contracts.Authentication.Requests
@using BeautySalonBooking.WebApp.Interfaces
@using BeautySalonBooking.WebApp.Interfaces.Common
@using BeautySalonBooking.WebApp.Interfaces.Login
@using BeautySalonBooking.WebApp.Models
@using BeautySalonBooking.WebApp.Services
@using Microsoft.Extensions.Caching.Memory
@inject IMemoryCache MemoryCache
@inject ILoginService AuthService
@inject ITokenService TokenService

<PageTitle>ورود | بیوتی سالن</PageTitle>
<main class="login-page beauty-login" dir="rtl">
    <section class="login-visual">
        <div class="visual-glow glow-one"></div>
        <div class="visual-glow glow-two"></div>
        <div class="visual-content">
            <span class="eyebrow">سامانه مدیریت آرایشگاه</span>
            <h1>مدیریت ساده‌تر،<br />رشد زیباتر.</h1>
            <p>سالن‌ها، خدمات، کارکنان و درخواست‌های خود را در یک فضای امن و یکپارچه مدیریت کنید.</p>
            <div class="dashboard-card">
                <div class="card-top">
                    <span>وضعیت امروز سالن‌ها</span>
                    <span class="more">•••</span>
                </div>
                <div class="task-row"><span class="task-check checked">✓</span><span></span><b></b></div>
                <div class="task-row"><span class="task-check checked">✓</span><span></span><b></b></div>
            </div>
        </div>
        <p class="visual-footer">© ۲۰۲۶ بیوتی سالن. همه حقوق محفوظ است.</p>
    </section>
    <section class="login-panel">
        <div class="form-wrap">
            <div class="login-identity">
                <img src="images/salon-logo.png" alt="لوگوی بیوتی سالن" />
                <div>
                    <h1>بیوتی سالن</h1>
                    <p>سامانه مدیریت آرایشگاه</p>
                </div>
            </div>

            <EditForm Model="phoneModel" OnValidSubmit="SendOtp" class="login-form">
                <DataAnnotationsValidator />

                <div class="field-group">
                    <label for="phone">شماره موبایل</label>
                    <div class="input-shell phone-input">

                        <InputText id="phone"
                                   @bind-Value="phoneModel.Phone"
                                   placeholder="912 345 6789"
                                   autocomplete="tel"
                                   inputmode="numeric"
                                   @oninput="OnPhoneInput" />
                        <div class="country-code">
                            <span>98+</span>
                        </div>
                    </div>
                    <ValidationMessage For="@(() => phoneModel.Phone)" />
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <span class="validation-message">@_errorMessage</span>
                    }
                </div>

                <button class="submit-button" type="submit" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span>در حال ارسال...</span>
                    }
                    else
                    {
                        <span>دریافت کد تایید <span>←</span></span>
                    }
                </button>
            </EditForm>

            <p class="login-help">در صورت نداشتن دسترسی، با مدیر سیستم تماس بگیرید.</p>
        </div>
    </section>
</main>

@code {
    private bool _isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isInitialized = true;

            // بررسی اینکه کاربر لاگین هست یا نه
            var token = await TokenService.GetAccessTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                Navigation.NavigateTo("/dashboard", true);
            }

            StateHasChanged();
        }
    }
    private readonly PhoneModel phoneModel = new();
    private string? _errorMessage;
    private bool _isLoading = false;

    private void OnPhoneInput(ChangeEventArgs e)
    {
        // فقط اعداد را نگه دارید و حداکثر 10 رقم
        var value = e.Value?.ToString() ?? string.Empty;
        var digits = new string(value.Where(char.IsDigit).ToArray());

        if (digits.Length > 10)
        {
            digits = digits[..10];
        }

        phoneModel.Phone = digits;
    }

    private async Task SendOtp()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            // شماره موبایل بدون صفر (با حذف احتمالی صفر اول)
            var mobileWithoutZero = phoneModel.Phone.TrimStart('0');

            // اگر شماره خالی بود یا کمتر از 10 رقم بود
            if (string.IsNullOrEmpty(mobileWithoutZero) || mobileWithoutZero.Length < 10)
            {
                _errorMessage = "شماره موبایل باید ۱۰ رقم باشد (به جز ۰۹)";
                return;
            }

            // آماده‌سازی درخواست
            var request = new LoginInitiateRequest
                {
                    MobileNumber = mobileWithoutZero
                };

            // فراخوانی API
            var response = await AuthService.RequestLoginOtpAsync(request);

            if (!response.IsSuccess)
            {
                _errorMessage = response.Message;
                return;
            }

            // اگر API موفق بود و SessionId برگرداند
            if (response.IsSuccess)
            {
                // تولید SessionId یکتا
                var sessionId = Guid.NewGuid().ToString();

                // ذخیره اطلاعات در MemoryCache
                var otpData = new OtpData
                    {
                        Phone = phoneModel.Phone,
                        Otp = "",
                        CreatedAt = DateTime.UtcNow
                    };

                MemoryCache.Set(sessionId, otpData, TimeSpan.FromMinutes(5));





                Navigation.NavigateTo($"/verify-otp?sessionId={sessionId}");
            }
            else
            {
                Navigation.NavigateTo($"/verify-otp?mobile={mobileWithoutZero}");
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "خطا در ارسال کد تایید. لطفاً مجدداً تلاش کنید.";
            Console.WriteLine($"❌ Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private sealed class PhoneModel
    {
        [Required(ErrorMessage = "وارد کردن شماره موبایل الزامی است.")]
        [MinLength(10, ErrorMessage = "شماره موبایل باید ۱۰ رقم باشد (به جز ۰۹)")]
        [MaxLength(10, ErrorMessage = "شماره موبایل باید ۱۰ رقم باشد (به جز ۰۹)")]
        [RegularExpression(@"^\d{10}$", ErrorMessage = "شماره موبایل باید ۱۰ رقم باشد (به جز ۰۹)")]
        public string Phone { get; set; } = string.Empty;
    }
}