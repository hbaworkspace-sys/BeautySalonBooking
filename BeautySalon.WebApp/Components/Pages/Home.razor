@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation
<PageTitle>ورود | بیوتی سالن</PageTitle>
<main class="login-page beauty-login" dir="rtl">
    <section class="login-visual">
        <div class="visual-glow glow-one"></div>
        <div class="visual-glow glow-two"></div>
        <div class="visual-content">
            <span class="eyebrow">سامانه مدیریت آرایشگاه</span>
            <h1>مدیریت ساده‌تر،<br />رشد زیباتر.</h1>
            <p>سالن‌ها، خدمات، کارکنان و درخواست‌های خود را در یک فضای امن و یکپارچه مدیریت کنید.</p>
            <div class="dashboard-card">
                <div class="card-top">
                    <span>وضعیت امروز سالن‌ها</span>
                    <span class="more">•••</span>
                    </div><div class="task-row"><span class="task-check checked">✓</span><span></span><b></b></div><div class="task-row"><span class="task-check checked">✓</span><span></span><b></b></div></div></div><p class="visual-footer">© ۲۰۲۶ بیوتی سالن. همه حقوق محفوظ است.</p>
    </section>
    <section class="login-panel">
        <div class="form-wrap">
            <div class="login-identity"><img src="images/salon-logo.png" alt="لوگوی بیوتی سالن" /><div><h1>بیوتی سالن</h1><p>سامانه مدیریت آرایشگاه</p></div></div><EditForm Model="credentials" OnValidSubmit="SignIn" class="login-form">
                <DataAnnotationsValidator /><div class="field-group"><label for="username">نام کاربری</label><div class="input-shell"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5" /><path d="M4.5 20a7.5 7.5 0 0 1 15 0" /></svg><InputText id="username" @bind-Value="credentials.Username" placeholder="نام کاربری خود را وارد کنید" autocomplete="username" /></div><ValidationMessage For="@(() => credentials.Username)" /></div><div class="field-group"><div class="label-row"><label for="password">رمز عبور</label><a href="/">رمز عبور را فراموش کرده‌اید؟</a></div><div class="input-shell"><svg viewBox="0 0 24 24"><rect x="4.5" y="10" width="15" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg><InputText id="password" type="@(_showPassword ? "text" : "password")" @bind-Value="credentials.Password" placeholder="رمز عبور خود را وارد کنید" autocomplete="current-password" /><button class="password-toggle" type="button" @onclick="TogglePassword">@(_showPassword ? "پنهان" : "نمایش")</button></div><ValidationMessage For="@(() => credentials.Password)" /></div><div class="field-group">
                    <label for="captcha">کد امنیتی</label><div class="captcha-row"><div class="captcha-code">@_captchaAnswer</div><button class="captcha-refresh" type="button" @onclick="RefreshCaptcha">↻</button><InputText id="captcha" @bind-Value="_captchaInput" placeholder="کد را وارد کنید" inputmode="numeric" /></div>@if (!string.IsNullOrEmpty(_captchaError))
                    {
                        <span class="validation-message">@_captchaError</span>
                    }
                </div><label class="remember"><InputCheckbox @bind-Value="credentials.RememberMe" /> <span>مرا به خاطر بسپار</span></label><button class="submit-button" type="submit">ورود به پنل مدیریت <span>←</span></button>
            </EditForm><p class="login-help">در صورت نداشتن دسترسی، با مدیر سیستم تماس بگیرید.</p>
        </div>
    </section>
</main>
@code {
    private readonly Credentials credentials = new(); 
    private bool _showPassword;
    private int _captchaAnswer = Random.Shared.Next(10000, 99999);
    private string _captchaInput = string.Empty; 
    private string? _captchaError; 
    private void TogglePassword() => _showPassword = !_showPassword;
    private void RefreshCaptcha() {
        _captchaAnswer = Random.Shared.Next(10000, 99999);
        _captchaInput = string.Empty;
    }
    private void SignIn() {
        if (_captchaInput != _captchaAnswer.ToString()) 
        {
            _captchaError = "کد امنیتی درست نیست."; 
             RefreshCaptcha();
             return;
        } 
        Navigation.NavigateTo("/dashboard");
    }
    private sealed class Credentials 
    { 
        [Required(ErrorMessage = "وارد کردن نام کاربری الزامی است.")]
        [MinLength(3, ErrorMessage = "نام کاربری باید حداقل ۳ کاراکتر باشد.")] 
        public string Username { get; set; } = string.Empty; 
        
        [Required(ErrorMessage = "وارد کردن رمز عبور الزامی است.")]
        [MinLength(6, ErrorMessage = "رمز عبور باید حداقل ۶ کاراکتر باشد.")]
        public string Password { get; set; } = string.Empty;
        
        public bool RememberMe { get; set; } 
    
    }
}
