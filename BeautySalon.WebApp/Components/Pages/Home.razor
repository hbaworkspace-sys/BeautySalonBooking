    // ==========================================
    // متغیرهای مرحله 7 (رزرو و احراز هویت)
    // ==========================================
    private string MobileNumber = string.Empty;
    private string OtpCode = string.Empty;
    private bool IsOtpSent = false;
    private bool IsProcessing = false;
    private bool IsBookingCompleted = false;
    private string? ErrorMessage;

    private async Task SendOtpAsync()
    {
        if (string.IsNullOrWhiteSpace(MobileNumber)) return;

        IsProcessing = true;
        ErrorMessage = null;

        try
        {
            var request = new BeautySalonBooking.Contracts.Authentication.Requests.LoginInitiateRequest
                {
                    MobileNumber = MobileNumber
                };

            var result = await LoginService.RequestLoginOtpAsync(request);

            if (result.IsSuccess)
            {
                IsOtpSent = true;
            }
            else
            {
                ErrorMessage = result.Message ?? "خطا در ارسال کد تایید";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sending OTP");
            ErrorMessage = "خطای غیرمنتظره رخ داد";
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task VerifyOtpAndBookAsync()
    {
        if (string.IsNullOrWhiteSpace(OtpCode)) return;

        IsProcessing = true;
        ErrorMessage = null;

        try
        {
            // 1. تایید کد OTP
            var verifyRequest = new BeautySalonBooking.Contracts.Authentication.Requests.VerifyOtpRequest
                {
                    MobileNumber = MobileNumber,
                    OtpCode = OtpCode // نام فیلد را با DTO واقعی خود تطبیق دهید
                };

            var authResult = await LoginService.VerifyLoginOtpAsync(verifyRequest);

            if (!authResult.IsSuccess)
            {
                ErrorMessage = authResult.Message ?? "کد تایید نامعتبر است";
                return;
            }

            // 2. ثبت نهایی رزرو
            var bookingRequest = new BeautySalonBooking.Contracts.Booking.CreateBooking.Requests.CreateBookingRequest
                {
                    BranchMemberServiceId = SelectedMember!.BranchMemberServiceId,
                    Date = SelectedDate!.Date,
                    StartTime = SelectedTime!.StartTime,
                    Note = string.Empty // می‌توانید یک فیلد ورودی برای یادداشت اضافه کنید
                };

            var bookingResult = await BookingApiService.CreateBookingAsync(bookingRequest);

            if (bookingResult.IsSuccess)
            {
                IsBookingCompleted = true;
            }
            else
            {
                ErrorMessage = bookingResult.Message ?? "خطا در ثبت رزرو";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error verifying OTP or creating booking");
            ErrorMessage = "خطای غیرمنتظره در ثبت رزرو";
        }
        finally
        {
            IsProcessing = false;
        }
    }
