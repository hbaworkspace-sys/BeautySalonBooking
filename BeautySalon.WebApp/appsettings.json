{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiBaseUrl": "https://localhost:7036/", // آدرس API شما
  "ApiSettings": {
    "BaseUrl": "https://localhost:7036/",
    "Endpoints": {
      "Authentication": {
        "RequestOtp": "api/Authentication/login/request-otp",
        "VerifyOtp": "api/Authentication/login/verify-otp",
        "RefreshToken": "api/Authentication/refresh-token"
