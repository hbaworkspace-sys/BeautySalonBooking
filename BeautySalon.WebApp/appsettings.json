        "UpdateProfile": "api/User/update"
      },
      "Category": {
        "GetRoots": "api/Categories/roots",
        "GetChildren": "api/Categories/children",
        "Create": "api/Categories",
        "Update": "api/Categories",
        "Delete": "api/Categories"
      },
      "Roles": {
        "GetAll": "api/Role",
        "GetById": "api/Role",
        "Create": "api/Role",
        "Update": "api/Role",
        "Delete": "api/Role"
