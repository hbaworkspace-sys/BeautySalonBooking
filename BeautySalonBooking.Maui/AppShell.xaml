<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BeautySalonBooking.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:main="clr-namespace:BeautySalonBooking.Maui.Features.Main.Views"
    xmlns:splash="clr-namespace:BeautySalonBooking.Maui.Features.Splash.Views"
    FlowDirection="RightToLeft"
    Shell.NavBarIsVisible="False">

    <ShellContent ContentTemplate="{DataTemplate splash:SplashPage}" Route="Splash" />

    <ShellContent ContentTemplate="{DataTemplate main:MainPage}" Route="main" />
</Shell>