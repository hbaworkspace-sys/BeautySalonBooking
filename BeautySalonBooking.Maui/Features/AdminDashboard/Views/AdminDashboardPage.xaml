<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeautySalonBooking.Maui.Features.AdminDashboard.AdminDashboardPage"
             NavigationPage.HasNavigationBar="False"
             xmlns:uc="clr-namespace:BeautySalonBooking.Maui.UserControls"
             xmlns:icon="clr-namespace:BeautySalonBooking.Maui.Resources"
             
             xmlns:vm="clr-namespace:BeautySalonBooking.Maui.Features.AdminDashboard.ViewModels"
             x:DataType="vm:AdminDashboardViewModel">
    <Grid
        x:Name="MainGrid"
        RowDefinitions="40,100,200,75"
        FlowDirection="RightToLeft">
        <Border
            Grid.Row="1"
            Padding="15"
            Margin="10,0,10,0"
            BackgroundColor="#d7837f">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15,15,15,15"/>
            </Border.StrokeShape>
        </Border>
        <ScrollView
            Grid.Row="2">
            <Grid
                Margin="0,10,0,0"
                ColumnDefinitions="*,*,*"
                RowDefinitions="*,*"
                ColumnSpacing="1">
                <uc:IconButtonViewPro
                    Grid.Row="0"
                    Grid.Column="0"
                    Title="درخواست سالن"
                    HCommand="{Binding SalonRequestsCommand}"
                    IconGlyph="{x:Static icon:IconSymbols.Spa}"/>

                <uc:IconButtonViewPro
                    Grid.Row="0"
                    Grid.Column="1"
                    Title="گزارشات"
                    IconGlyph="{x:Static icon:IconSymbols.LocationCity}"/>

                <uc:IconButtonViewPro
                    Grid.Row="0"
                    Grid.Column="2"
                    Title="آمار"
                    IconGlyph="{x:Static icon:IconSymbols.LocalShipping}"/>

                <uc:IconButtonViewPro
                    Grid.Row="1"
                    Grid.Column="0"
                    Title="نوبت ها"
                    IconGlyph="{x:Static icon:IconSymbols.Timer}" />

                <uc:IconButtonViewPro
                    Grid.Row="1"
                    Grid.Column="1"
                    Title="امور آرایشگران"
                    IconGlyph="{x:Static icon:IconSymbols.ShoppingCart}"/>

                <uc:IconButtonViewPro
                    Grid.Row="1"
                    Grid.Column="2"
                    Title="امور مشتریان"
                    IconGlyph="{x:Static icon:IconSymbols.AttachMoney}"/>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>