<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeautySalonBooking.Maui.Features.Auth.RegisterPage"
             NavigationPage.HasNavigationBar="False"
             xmlns:uc="clr-namespace:BeautySalonBooking.Maui.UserControls"
             xmlns:ucBtn="clr-namespace:BeautySalonBooking.Maui.UserControls.ButtonControl"
             BackgroundColor="{StaticResource White}"
             xmlns:vm="clr-namespace:BeautySalonBooking.Maui.Features.Auth"
             x:DataType="vm:RegisterViewModel"
             xmlns:icon="clr-namespace:BeautySalonBooking.Maui.Resources">

    <Grid
        RowDefinitions="auto,auto,*,auto,auto"
        RowSpacing="20"
        Padding="15,10,15,10">

        <ucBtn:NextAndBackButtonView
            Grid.Row="0"
            IsBackVisible="True"/>

        <uc:TitleSubtitleView
            Grid.Row="1"
            Title="ثبت نام"
            Subtitle="لطفا اطلاعات خود را وارد کنید"/>

        <VerticalStackLayout
            Grid.Row="2"
            Spacing="10"
            VerticalOptions="Center">

            <uc:TextEntry
                PlaceHolder="نام"
                Glyph="{x:Static icon:IconSymbols.Person}"
                Text="{Binding FirstName ,Mode=TwoWay}"/>

            <uc:TextEntry
                PlaceHolder="نام خانوادگی"
                Glyph="{x:Static icon:IconSymbols.Person}"
                Text="{Binding LastName,Mode=TwoWay}"/>

            <uc:PhoneNumberEntry
                Text="{Binding PhoneNumber,Mode=TwoWay}"
                PhoneType="Mobile"/>

            <uc:NumericEntry
                PlaceHolder="کد ملی"
                Glyph="{x:Static icon:IconSymbols.IdCard}"
                Text="{Binding NationalCode, Mode=TwoWay}"/>

            <uc:TextEntry
                PlaceHolder="جنسیت"
                Glyph="{x:Static icon:IconSymbols.IdCard}"
                />

        </VerticalStackLayout>

        <uc:DefaultButton
            Grid.Row="3"
            HCommand="{Binding RegisterCommand}"
            Title="ثبت نام"/>

        <uc:TextLink
            Grid.Row="4"
            QuestionText="حساب کاربری دارید؟"
            Text="وارد شوید"
            HorizontalOptions="Center"
            HCommand="{Binding GoToLoginCommand}"/>
    </Grid>
</ContentPage>