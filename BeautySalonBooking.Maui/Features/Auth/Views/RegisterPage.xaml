<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BeautySalonBooking.Maui.Features.Auth.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:btn="clr-namespace:BeautySalonBooking.Maui.Components.Button"
    xmlns:icon="clr-namespace:BeautySalonBooking.Maui.Resources"
    xmlns:nav="clr-namespace:BeautySalonBooking.Maui.Components.Navigation"
    xmlns:uc="clr-namespace:BeautySalonBooking.Maui.UserControls"
    xmlns:vm="clr-namespace:BeautySalonBooking.Maui.Features.Auth.ViewModels"
    x:DataType="vm:RegisterViewModel"
    BackgroundColor="{StaticResource White}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <nav:NavigationHeaderView
            Grid.Row="0"
            BackCommand="{Binding GoBackCommand}"
            IsBackEnabled="True"
            IsBackVisible="True" />

        <Grid
            Grid.Row="1"
            Padding="16"
            RowDefinitions="Auto,*,auto,auto"
            RowSpacing="25">


            <uc:TitleSubtitleView
                Title="ثبت نام"
                Grid.Row="0"
                Subtitle="لطفا اطلاعات خود را وارد کنید" />

            <VerticalStackLayout
                Grid.Row="1"
                Spacing="10"
                VerticalOptions="Center">

                <uc:TextEntry
                    Glyph="{x:Static icon:IconSymbols.Person}"
                    PlaceHolder="نام"
                    Text="{Binding FirstName, Mode=TwoWay}" />

                <uc:TextEntry
                    Glyph="{x:Static icon:IconSymbols.Person}"
                    PlaceHolder="نام خانوادگی"
                    Text="{Binding LastName, Mode=TwoWay}" />

                <uc:PhoneNumberEntry PhoneType="Mobile" Text="{Binding PhoneNumber, Mode=TwoWay}" />

                <uc:NumericEntry
                    Glyph="{x:Static icon:IconSymbols.IdCard}"
                    PlaceHolder="کد ملی"
                    Text="{Binding NationalCode, Mode=TwoWay}" />

                <uc:TextEntry
                    Glyph="{x:Static icon:IconSymbols.IdCard}"
                    PlaceHolder="جنسیت"
                    ReturnTypeValue="Done" />

            </VerticalStackLayout>

            <btn:PrimaryButtonView
                Title="ثبت نام"
                Grid.Row="2"
                Command="{Binding RegisterCommand}">
                <btn:PrimaryButtonView.FillBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#ccFFBB80" />
                        <GradientStop Offset="1.1" Color="#ccEA6A96" />
                    </LinearGradientBrush>
                </btn:PrimaryButtonView.FillBrush>
            </btn:PrimaryButtonView>

            <uc:TextLink
                Grid.Row="3"
                HCommand="{Binding GoToLoginCommand}"
                HorizontalOptions="Center"
                QuestionText="حساب کاربری دارید؟"
                Text="وارد شوید" />
        </Grid>
    </Grid>
</ContentPage>