<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BeautySalonBooking.Maui.Features.Auth.OtpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icon="clr-namespace:BeautySalonBooking.Maui.Resources"
    xmlns:nav="clr-namespace:BeautySalonBooking.Maui.Components.Navigation"
    xmlns:uc="clr-namespace:BeautySalonBooking.Maui.UserControls"
    xmlns:vm="clr-namespace:BeautySalonBooking.Maui.Features.Auth"
    x:DataType="vm:OtpViewModel"
    BackgroundColor="{StaticResource White}"
    NavigationPage.HasNavigationBar="False">
    <Grid
        Padding="15,10,15,10"
        RowDefinitions="auto,auto,*,0.5*"
        RowSpacing="20">

        <nav:NavigationButtonsView
            Grid.Row="0"
            BackCommand="{Binding GoBackCommand}"
            NavigationMode="Back" />

        <uc:TitleSubtitleView
            Title="کد تایید"
            Grid.Row="1"
            Subtitle="کد 4 رقمی ارسال شده را وارد کنید" />

        <VerticalStackLayout
            Grid.Row="2"
            Spacing="30"
            VerticalOptions="Center">

            <uc:OtpCodeEntry x:Name="txtOtp" OtpCode="{Binding OtpCode, Mode=OneWayToSource}" />

            <uc:CountdownView
                Title="ارسال مجدد تا"
                Grid.Row="3"
                ActionCommand="{Binding ResendOtpCommand}"
                ActionText="ارسال مجدد کد"
                IsRunning="{Binding IsCountdownRunning, Mode=TwoWay}"
                Duration="{Binding CountdownSeconds, Mode=TwoWay}" />

            <uc:DefaultButton
                Title="ورود"
                Grid.Row="3"
                HCommand="{Binding VerifyOtpCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>