<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BeautySalonBooking.Maui.Features.Auth.Views.OtpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:btn="clr-namespace:BeautySalonBooking.Maui.Components.Button"
    xmlns:icon="clr-namespace:BeautySalonBooking.Maui.Resources"
    xmlns:indicator="clr-namespace:BeautySalonBooking.Maui.Components.Indicator"
    xmlns:input="clr-namespace:BeautySalonBooking.Maui.Components.Input"
    xmlns:nav="clr-namespace:BeautySalonBooking.Maui.Components.Navigation"
    xmlns:shared="clr-namespace:BeautySalonBooking.Maui.Components.Shared"
    xmlns:uc="clr-namespace:BeautySalonBooking.Maui.UserControls"
    xmlns:vm="clr-namespace:BeautySalonBooking.Maui.Features.Auth.ViewModels"
    x:DataType="vm:OtpViewModel"
    BackgroundColor="{StaticResource White}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <nav:NavigationHeaderView
            Grid.Row="0"
            BackCommand="{Binding GoBackCommand}"
            IsBackEnabled="True"
            IsBackVisible="True" />
        <Grid
            Grid.Row="1"
            Padding="16"
            RowDefinitions="Auto,*,*"
            RowSpacing="25">

            <uc:TitleSubtitleView
                Title="کد تایید"
                Grid.Row="0"
                Subtitle="{Binding NavigationModel.MobileNumber, StringFormat='کد 6 رقمی برای شماره 0{0} ارسال شد، لطفا آن را وارد کنید'}" />

            <VerticalStackLayout
                Grid.Row="1"
                Spacing="10"
                VerticalOptions="Center">

                <input:OtpCodeEntry
                    x:Name="txtOtp"
                    OnCompleted="txtOtp_OnCompleted"
                    OtpCode="{Binding OtpCode, Mode=OneWayToSource}" />

                <shared:TextLink
                    Margin="15,0"
                    Command="{Binding GoBackCommand}"
                    HorizontalOptions="End"
                    Text="ویرایش شماره" />

                <uc:CountdownView
                    Title="ارسال مجدد تا"
                    Grid.Row="3"
                    ActionCommand="{Binding ResendOtpCommand}"
                    ActionText="ارسال مجدد کد"
                    IsRunning="{Binding IsCountdownRunning, Mode=TwoWay}"
                    Duration="{Binding CountdownSeconds, Mode=TwoWay}" />

                <btn:PrimaryButtonView
                    Title="ورود"
                    Grid.Row="3"
                    Command="{Binding VerifyOtpCommand}">
                    <btn:PrimaryButtonView.FillBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#ccFFBB80" />
                            <GradientStop Offset="1.1" Color="#ccEA6A96" />
                        </LinearGradientBrush>
                    </btn:PrimaryButtonView.FillBrush>
                </btn:PrimaryButtonView>
            </VerticalStackLayout>

            <indicator:LoadingIndicator
                Grid.Row="0"
                Grid.RowSpan="3"
                IsLoading="{Binding IsBusy}"
                Message="لطفاً صبر کنید..."
                OverlayColor="#CCFFFFFF"
                SpinnerColor="#7d0a26"
                SpinnerSize="50" />

        </Grid>
    </Grid>
</ContentPage>