<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BeautySalonBooking.Maui.Features.Booking.Views.StylistSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:card="clr-namespace:BeautySalonBooking.Maui.Components.Card"
    xmlns:headers="clr-namespace:BeautySalonBooking.Maui.Components.Header"
    xmlns:indicator="clr-namespace:BeautySalonBooking.Maui.Components.Indicator"
    xmlns:media="clr-namespace:BeautySalonBooking.Maui.Components.Media"
    xmlns:model_bms="clr-namespace:BeautySalonBooking.Maui.Features.Branch.Models"
    xmlns:nav="clr-namespace:BeautySalonBooking.Maui.Components.Navigation"
    xmlns:shared="clr-namespace:BeautySalonBooking.Maui.Components.Shared"
    xmlns:vm="clr-namespace:BeautySalonBooking.Maui.Features.Booking.ViewModels"
    x:DataType="vm:StylistSelectionViewModel"
    BackgroundColor="{x:StaticResource White}"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="0">

        <nav:NavigationHeaderView
            x:Name="HeaderView"
            Title="انتخاب استایلیست"
            Grid.Row="0"
            BackCommand="{Binding GoBackCommand}"
            IsBackEnabled="True"
            IsBackVisible="True" />

        <headers:SectionTitleView
            Title="سالن انتخابی"
            Grid.Row="1"
            Margin="20,10,0,10"
            ShowDivider="False" />

        <card:OrganizationCardView
            Grid.Row="2"
            Margin="15,5"
            AvailableTimes="19"
            BadgeType="None"
            BeauticianCount="25"
            BranchTitle="{Binding SelectedBranch.BranchTitle}"
            ImageSource="{Binding SelectedBranch.ImageSource}"
            OrganizationName="{Binding SelectedBranch.OrganizationTitle}"
            Rating="4.5" />

        <headers:SectionTitleView
            Title="استایلیست های این سالن"
            Grid.Row="3"
            Margin="20,30,10,10"
            ShowDivider="False" />

        <CollectionView
            Grid.Row="4"
            Margin="15,5"
            ItemsSource="{Binding Members}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model_bms:BranchMemberServiceModel">

                    <card:StylistSelectionCardView
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectMemberCommand}"
                        CommandParameter="{Binding .}"
                        FirstAvailableTime="15:30"
                        ImageSource="{Binding ImageSource}"
                        Price="{Binding Price}"
                        Rating="0"
                        StylistName="{Binding FullName}"
                        StylistTitle="استایلیست ارشد"
                        Duration="{Binding Duration}" />

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <indicator:LoadingIndicator
            Grid.Row="3"
            Grid.RowSpan="2"
            IsLoading="{Binding IsLoading}"
            Message="لطفاً صبر کنید..."
            OverlayColor="#CCFFFFFF"
            SpinnerColor="#7d0a26"
            SpinnerSize="50" />
    </Grid>
</ContentPage>