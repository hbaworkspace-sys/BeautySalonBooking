                            Grid.Row="1"
                            Grid.Column="1"
                            Padding="8,4"
                            BackgroundColor="{StaticResource SuccessBackgroundColor}"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            VerticalOptions="End">

