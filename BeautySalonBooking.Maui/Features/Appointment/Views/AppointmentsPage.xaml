                                Grid.Row="3"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="5">

                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="ساعت 15:00" />

                                <Label
                                    Grid.Column="0"
                                    FontSize="16"
                                    Text="◌"
                                    TextColor="{StaticResource PrimaryColor}" />

                            </Grid>




                        </Grid>


                        <!--  Status  -->
