                                Grid.Row="2"
                                ColumnDefinitions="auto,*"
                                ColumnSpacing="5">

                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="شنبه 16 آبان 1405" />

                                <Label
                                    Grid.Column="0"
                                    FontSize="14"
                                    Text="▣"
                                    TextColor="{StaticResource PrimaryColor}" />

                            </Grid>


                            <!--  Time  -->
