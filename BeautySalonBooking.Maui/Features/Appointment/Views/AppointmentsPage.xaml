                    HorizontalTextAlignment="Center"
                    Text="آینده"
                    TextColor="{StaticResource PrimaryColor}"
                    VerticalTextAlignment="Center" />

                <BoxView
                    BackgroundColor="{StaticResource PrimaryColor}"
                    HeightRequest="1.5"
                    HorizontalOptions="Fill"
                    VerticalOptions="End" />
            </Grid>

