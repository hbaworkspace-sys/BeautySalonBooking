                        <Border
                            Grid.Column="1"
                            HeightRequest="100"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="100">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="50" />
                            </Border.StrokeShape>

                            <Image Aspect="AspectFill" Source="onboarding_chair.png" />

                        </Border>


                        <!--  Information  -->
                        <Grid
                            Grid.Column="0"
                            RowDefinitions="Auto,Auto,Auto,Auto,*"
                            RowSpacing="4">


                            <!--  Salon Name  -->
                            <Label
                                Grid.Row="0"
                                FontAttributes="Bold"
                                Text="سالن آرزو رحیمی" />


                            <!--  Services  -->
                            <Label
                                Grid.Row="1"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="رنگساژ مو • کوتاهی" />


                            <!--  Date  -->
