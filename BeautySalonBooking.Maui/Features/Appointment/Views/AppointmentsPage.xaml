            Grid.Row="0"
            Padding="15,18,15,8"
            ColumnDefinitions="50,*">

            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="32"
                HorizontalOptions="Start"
                Text="‹"
                TextColor="#999999"
                VerticalOptions="Center" />

            <!--  Title  -->
            <Label
                Grid.Column="0"
                Grid.ColumnSpan="2"
                FontAttributes="Bold"
                FontSize="18"
                HorizontalTextAlignment="Center"
                Text="نوبت های من"
                TextColor="{StaticResource TextPrimaryColor}"
                VerticalTextAlignment="Center" />

        </Grid>

