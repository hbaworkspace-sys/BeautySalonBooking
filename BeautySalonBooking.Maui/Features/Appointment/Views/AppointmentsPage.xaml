        <Color x:Key="IconColor">#999999</Color>

        <!--
            =========================
            Appointment Card
            =========================
        -->

        <Style x:Key="AppointmentCardStyle" TargetType="Border">

            <Setter Property="BackgroundColor" Value="White" />

            <Setter Property="Stroke" Value="{StaticResource BorderColor}" />

            <Setter Property="StrokeThickness" Value="1.5" />

            <Setter Property="Padding" Value="10" />

            <Setter Property="Margin" Value="0,0,0,22" />

            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="10" />
                </Setter.Value>
            </Setter>

        </Style>

        <!--
            =========================
            Secondary Text
            =========================
        -->

        <Style x:Key="SecondaryTextStyle" TargetType="Label">

            <Setter Property="FontSize" Value="11" />

            <Setter Property="TextColor" Value="{StaticResource TextSecondaryColor}" />

        </Style>

    </ContentPage.Resources>

