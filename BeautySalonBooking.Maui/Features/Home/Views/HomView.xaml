            <Grid
                Grid.Row="0"
                ColumnDefinitions="75,*,40"
                ColumnSpacing="3">
                <Border
                    Grid.Column="0"
                    HeightRequest="50"
                    Style="{x:StaticResource CardBorderStyle}">
                    <Grid
                        Padding="4"
                        ColumnDefinitions="13,*,13"
                        ColumnSpacing="2">
                        <Label
                            Grid.Column="0"
                            FontSize="16"
                            Style="{StaticResource GlyphLable}"
                            Text="{x:Static icon:IconSymbols.KeyboardArrowDown}"
                            TextColor="Black" />
                        <Label
                            Grid.Column="1"
                            FontSize="13"
                            HorizontalTextAlignment="Center"
                            Text="تهران" />
                        <Image Grid.Column="2" Source="location.png" />
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="5"
                    HeightRequest="50"
                    Style="{x:StaticResource CardBorderStyle}">
                    <Grid ColumnDefinitions="*,20">
                        <Label
                            Grid.Column="0"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="جستجوی سالن ها، خدمات، آرایشگرها ..." />
                        <Label
                            Grid.Column="1"
                            FontFamily="MaterialIcons"
                            FontSize="24"
                            Style="{x:StaticResource GlyphLable}"
                            Text="{x:Static icon:IconSymbols.Search}" />
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    HeightRequest="50"
                    Style="{x:StaticResource CardBorderStyle}">
                    <ImageButton Padding="6" Source="bell.png" />
                </Border>
            </Grid>

