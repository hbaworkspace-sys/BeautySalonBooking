<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.Features.Profile.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:card="clr-namespace:BeautySalonBooking.Maui.Components.Card"
    xmlns:header="clr-namespace:BeautySalonBooking.Maui.Components.Header"
    xmlns:model="clr-namespace:BeautySalonBooking.Maui.Features.Profile.Models"
    xmlns:profile="clr-namespace:BeautySalonBooking.Maui.Components.Profile"
    xmlns:shared="clr-namespace:BeautySalonBooking.Maui.Components.Shared"
    xmlns:vm="clr-namespace:BeautySalonBooking.Maui.Features.Profile.ViewModels"
    x:DataType="vm:ProfileViewModel"
    BackgroundColor="#FAF8FA"
    FlowDirection="RightToLeft">

    <Grid>
        <ScrollView IsVisible="{Binding IsOverviewVisible}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,70" RowSpacing="10">

                <Border Grid.Row="0" Padding="20,50,20,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#eeb1c6" />
                            <GradientStop Offset="1" Color="White" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12"
                        RowDefinitions="auto, auto, auto"
                        RowSpacing="20">

                        <profile:ProfileAvatarView
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="76"
                            Image="salon_q1r2.png"
                            Initials="{Binding Initials}"
                            WidthRequest="76" />

                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            Spacing="3"
                            VerticalOptions="Center">
                            <Label FontAttributes="Bold" Text="{Binding FullName}" />
                            <!--  Text="{Binding PhoneNumber}"  -->
                            <Label Style="{StaticResource Caption}" Text="09123771893" />
                            <Border
                                Padding="10,2"
                                Background="#f7dce5"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 8">
                                <Label
                                    FontSize="11"
                                    HorizontalOptions="Center"
                                    Text="{Binding RolesSummary}"
                                    TextColor="#D94B7D" />
                            </Border>
                        </VerticalStackLayout>
                        <shared:ActionIconView
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="5"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static model:ProfileScreen.EditProfile}"
                            CornerRadius="5"
                            FillBrush="#fff0f5"
                            HorizontalOptions="Center"
                            Icon="edit_square"
                            IconColor="#D94B7D"
                            IconSize="16"
                            TouchSize="25"
                            VerticalOptions="Center" />
                        <Grid
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,15,0,0"
                            ColumnDefinitions="*,1,*"
                            HorizontalOptions="FillAndExpand">

                            <VerticalStackLayout
                                Grid.Column="0"
                                HorizontalOptions="Center"
                                Spacing="2">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    HorizontalTextAlignment="Center"
                                    Text="128"
                                    TextColor="#29242A" />

                                <Label
                                    FontSize="11"
                                    HorizontalTextAlignment="Center"
                                    Text="دنبال‌شونده"
                                    TextColor="#77717A" />
                            </VerticalStackLayout>

                            <BoxView
                                Grid.Column="1"
                                Margin="0,4"
                                BackgroundColor="#EEE8ED"
                                VerticalOptions="Fill"
                                WidthRequest="1" />

                            <VerticalStackLayout
                                Grid.Column="2"
                                HorizontalOptions="Center"
                                Spacing="2">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    HorizontalTextAlignment="Center"
                                    Text="62"
                                    TextColor="#29242A" />

                                <Label
                                    FontSize="11"
                                    HorizontalTextAlignment="Center"
                                    Text="دنبال‌کننده"
                                    TextColor="#77717A" />
                            </VerticalStackLayout>

                        </Grid>
                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Padding="12"
                            Background="#fff6fb"
                            Stroke="#ED5F91"
                            StrokeShape="RoundRectangle 8">
                            <Grid RowDefinitions="auto,auto,auto" RowSpacing="5">

                                <header:SectionHeaderView
                                    Title="تکمیل پروفایل"
                                    Grid.Row="0"
                                    ActionText="75%" />

                                <ProgressBar
                                    x:Name="MyProgressBar"
                                    Grid.Row="1"
                                    Progress="{Binding Progress}"
                                    ProgressColor="#ED5F91" />

                                <Label
                                    Grid.Row="2"
                                    FontSize="12"
                                    Text="ایمیل خود را اضافه کنید"
                                    TextColor="Gray" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid
                    Grid.Row="1"
                    Padding="16,0"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10"
                    RowDefinitions="*,*"
                    RowSpacing="10">

                    <profile:ProfileKpiCard
                        Title="کل نوبت ها"
                        Grid.Row="0"
                        Grid.Column="0"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.AppointmentHistory}"
                        Detail="calendar_today"
                        Value="33" />

                    <profile:ProfileKpiCard
                        Title="نوبت های انجام شده"
                        Grid.Row="0"
                        Grid.Column="1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.AppointmentDetails}"
                        Detail="schedule"
                        Value="27" />

                    <profile:ProfileKpiCard
                        Title="نوبت‌های پیش رو"
                        Grid.Row="1"
                        Grid.Column="0"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.AppointmentHistory}"
                        Detail="check_circle"
                        Value="6" />

                    <profile:ProfileKpiCard
                        Title="مجموع هزینه ها"
                        Grid.Row="1"
                        Grid.Column="1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.SpendingSummary}"
                        Detail="paid"
                        Value="2.680.000 تومان" />
                </Grid>

                <card:SectionCardView
                    Title="حساب کاربری"
                    Grid.Row="2"
                    Margin="16,0">

                    <profile:SettingsRowView
                        Title="ویرایش اطلاعات شخصی"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.EditProfile}"
                        Icon="person" />

                    <profile:SettingsRowView
                        Title="تفییر شماره موبایل"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.ChangeMobile}"
                        Icon="call" />

                    <profile:SettingsRowView
                        Title="امنیت و نشست های فعال"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.Security}"
                        Icon="security" />

                </card:SectionCardView>

                <card:SectionCardView
                    Title="فعالیت های من"
                    Grid.Row="3"
                    Margin="16,0">

                    <profile:SettingsRowView Title="اخرین فعالیت ها" Icon="history" />

                    <profile:SettingsRowView Title="علاقه مندی ها" Icon="favorite" />

                    <profile:SettingsRowView Title="دخیره شده ها" Icon="bookmarks" />

                </card:SectionCardView>

                <card:SectionCardView
                    Title="تنظیمات برنامه"
                    Grid.Row="4"
                    Margin="16,0">

                    <profile:SettingsRowView
                        Title="اعلان‌ها"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.NotificationSettings}"
                        Icon="notifications" />

                    <profile:SettingsRowView
                        Title="ظاهر"
                        CommandParameter="{x:Static model:ProfileScreen.Appearance}"
                        Icon="palette" />

                    <profile:SettingsRowView
                        Title="زبان"
                        CommandParameter="{x:Static model:ProfileScreen.Language}"
                        Icon="language"
                        Value="فارسی" />

                    <profile:SettingsRowView
                        Title="حریم خصوصی"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.Privacy}"
                        Icon="shield" />

                </card:SectionCardView>

                <card:SectionCardView
                    Title="پشتیبانی"
                    Grid.Row="5"
                    Margin="16,0">

                    <profile:SettingsRowView
                        Title="راهنمای استفاده"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.Favorites}"
                        Icon="Menu_book" />

                    <profile:SettingsRowView
                        Title="سوالات متداول"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.HelpCenter}"
                        Icon="question_exchange" />

                    <profile:SettingsRowView
                        Title="تماس با پشتیبانی"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.ContactSupport}"
                        Icon="support_agent" />

                    <profile:SettingsRowView
                        Title="درباره ما"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.About}"
                        Icon="info" />

                </card:SectionCardView>

                <card:SectionCardView
                    Title="عملیات حساب"
                    Grid.Row="6"
                    Margin="16,0">

                    <profile:SettingsRowView
                        Title="خروج از حساب"
                        Command="{Binding LogoutCommand}"
                        Icon="logout" />

                    <profile:SettingsRowView
                        Title="حذف حساب کاربری"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static model:ProfileScreen.DeleteAccount}"
                        Icon="delete_forever"
                        IsDestructive="True" />

                </card:SectionCardView>

            </Grid>
        </ScrollView>

        <!--<ScrollView IsVisible="{Binding IsPhotoSelectionVisible}">
            <VerticalStackLayout Padding="20" Spacing="14">
                <profile:ProfileHeaderView Title="تصویر پروفایل" BackCommand="{Binding GoBackCommand}" />
                <profile:ProfileAvatarView HorizontalOptions="Center" Initials="{Binding Initials}" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource Caption}"
                    Text="یک ظاهر آزمایشی انتخاب کنید" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button
                        Command="{Binding SelectAvatarCommand}"
                        CommandParameter="rose"
                        Style="{StaticResource Primary}"
                        Text="رز" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding SelectAvatarCommand}"
                        CommandParameter="lilac"
                        Style="{StaticResource Primary}"
                        Text="یاسی" />
                    <Button
                        Grid.Column="2"
                        Command="{Binding SelectAvatarCommand}"
                        CommandParameter="peach"
                        Style="{StaticResource Primary}"
                        Text="هلویی" />
                </Grid>
                <Label Style="{StaticResource Caption}" Text="برای اتصال دوربین یا گالری، پیاده‌سازی واقعی بعداً باید از MediaPicker MAUI و سرویس بارگذاری استفاده کند؛ این نمونه هیچ فایل تصویری نگه نمی‌دارد." />
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView IsVisible="{Binding IsAccountInfoVisible}">
            <VerticalStackLayout Padding="20" Spacing="12">
                <profile:ProfileHeaderView Title="اطلاعات حساب" BackCommand="{Binding GoBackCommand}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource Caption}" Text="شماره همراه" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                FontAttributes="Bold"
                                FontFamily="Sans"
                                Text="{Binding PhoneNumber}" />
                            <Button
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static model:ProfileScreen.ChangeMobile}"
                                Text="تغییر"
                                TextColor="#D94B7D" />
                            <Label
                                Grid.Row="1"
                                Style="{StaticResource Caption}"
                                Text="کد ملی" />
                            <Label
                                Grid.Row="2"
                                FontFamily="Sans"
                                Text="{Binding NationalCode}" />
                            <Label
                                Grid.Row="3"
                                Style="{StaticResource Caption}"
                                Text="ایمیل" />
                            <Label
                                Grid.Row="4"
                                FontFamily="Sans"
                                Text="{Binding Email}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <profile:SettingsRowView
                    Title="امنیت حساب"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static model:ProfileScreen.Security}"
                    Description="نشست و روش ورود"
                    Icon="⌁" />
            </VerticalStackLayout>
        </ScrollView>




        <ScrollView IsVisible="{Binding IsSecurityVisible}">
            <VerticalStackLayout Padding="20" Spacing="12">
                <profile:ProfileHeaderView Title="امنیت" BackCommand="{Binding GoBackCommand}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontFamily="Sans"
                            Text="نشست امن" />
                        <Label Style="{StaticResource Caption}" Text="خروج از حساب، نشست ذخیره‌شدهٔ دستگاه را پاک می‌کند." />
                        <Button
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource Primary}"
                            Text="خروج از همه دستگاه‌ها" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView IsVisible="{Binding IsAppearanceVisible}">
            <VerticalStackLayout Padding="20" Spacing="12">
                <profile:ProfileHeaderView Title="ظاهر" BackCommand="{Binding GoBackCommand}" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label
                                FontAttributes="Bold"
                                FontFamily="Sans"
                                Text="حالت تیره" />
                            <Label Style="{StaticResource Caption}" Text="برای این نمونه، تم برنامه فوراً اعمال می‌شود." />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding IsDarkMode}"
                            OnColor="#ED5F91" />
                    </Grid>
                </Border>
                <profile:SettingsRowView
                    Title="زبان برنامه"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static model:ProfileScreen.Language}"
                    Icon="ز"
                    Value="فارسی" />
                <Button
                    Command="{Binding SaveAppearanceCommand}"
                    Style="{StaticResource Primary}"
                    Text="ذخیره ظاهر" />
            </VerticalStackLayout>
        </ScrollView>
        <ScrollView IsVisible="{Binding IsLanguageVisible}">
            <VerticalStackLayout Padding="20" Spacing="10">
                <profile:ProfileHeaderView Title="زبان" BackCommand="{Binding GoBackCommand}" />
                <Button
                    Command="{Binding SelectLanguageCommand}"
                    CommandParameter="fa"
                    Style="{StaticResource Primary}"
                    Text="فارسی" />
                <Button
                    BackgroundColor="White"
                    BorderColor="#ED5F91"
                    BorderWidth="1"
                    Command="{Binding SelectLanguageCommand}"
                    CommandParameter="en"
                    CornerRadius="15"
                    FontFamily="Sans"
                    HeightRequest="50"
                    Text="English"
                    TextColor="#D94B7D" />
                <Label Style="{StaticResource Caption}" Text="{Binding SuccessMessage}" />
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView IsVisible="{Binding IsHelpCenterVisible}">
            <VerticalStackLayout Padding="20" Spacing="12">
                <profile:ProfileHeaderView Title="مرکز راهنما" BackCommand="{Binding GoBackCommand}" />
                <CollectionView HeightRequest="220" ItemsSource="{Binding FaqItems}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" Style="{StaticResource Card}">
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="Sans"
                                    Text="{Binding .}" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static model:ProfileScreen.ContactSupport}"
                    Style="{StaticResource Primary}"
                    Text="تماس با پشتیبانی" />
            </VerticalStackLayout>
        </ScrollView>
        <ScrollView IsVisible="{Binding IsContactSupportVisible}">
            <VerticalStackLayout Padding="20" Spacing="10">
                <profile:ProfileHeaderView Title="تماس با پشتیبانی" BackCommand="{Binding GoBackCommand}" />
                <Label Style="{StaticResource Caption}" Text="موضوع" />
                <Entry Style="{StaticResource Field}" Text="{Binding SupportSubject}" />
                <Label Style="{StaticResource Caption}" Text="پیام شما" />
                <Editor
                    BackgroundColor="#FFF8FA"
                    FontFamily="Sans"
                    HeightRequest="140"
                    Text="{Binding SupportMessage}"
                    TextColor="#29242A" />
                <Label
                    FontFamily="Sans"
                    FontSize="12"
                    Text="{Binding ErrorMessage}"
                    TextColor="#D64550" />
                <Button
                    Command="{Binding SubmitSupportCommand}"
                    Style="{StaticResource Primary}"
                    Text="ارسال پیام" />
            </VerticalStackLayout>
        </ScrollView>
        <ScrollView IsVisible="{Binding IsAppointmentHistoryVisible}">
            <VerticalStackLayout Padding="20" Spacing="12">
                <profile:ProfileHeaderView Title="تاریخچه نوبت‌ها" BackCommand="{Binding GoBackCommand}" />
                <CollectionView HeightRequest="520" ItemsSource="{Binding Appointments}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:AppointmentSummaryDto">
                            <Border Margin="0,4" Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="Sans"
                                        Text="{Binding ServiceTitle}" />
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource Caption}"
                                        Text="{Binding SalonName}" />
                                    <Label
                                        Grid.Row="1"
                                        Style="{StaticResource Caption}"
                                        Text="{Binding StylistName}" />
                                    <Label
                                        Grid.Row="2"
                                        FontFamily="Sans"
                                        Text="{Binding Price, StringFormat='{}{0:N0} تومان'}"
                                        TextColor="#D94B7D" />
                                    <Button
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.OpenAppointmentCommand}"
                                        CommandParameter="{Binding Id}"
                                        Text="جزئیات"
                                        TextColor="#D94B7D" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <profile:ProfileStateView
                            Title="نوبتی ندارید"
                            Icon="○"
                            Message="نوبت‌های شما اینجا نشان داده می‌شوند." />
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <ScrollView IsVisible="{Binding IsAppointmentDetailsVisible}">
            <VerticalStackLayout Padding="20" Spacing="12">
                <profile:ProfileHeaderView Title="جزئیات نوبت" BackCommand="{Binding GoBackCommand}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="9">
                        <Label
                            FontAttributes="Bold"
                            FontFamily="Sans"
                            FontSize="18"
                            Text="{Binding SelectedAppointment.ServiceTitle}" />
                        <Label Style="{StaticResource Caption}" Text="{Binding SelectedAppointment.SalonName}" />
                        <Label Style="{StaticResource Caption}" Text="{Binding SelectedAppointment.BranchName}" />
                        <BoxView HeightRequest="1" Color="#F3EDF1" />
                        <Label FontFamily="Sans" Text="{Binding SelectedAppointment.StylistName}" />
                        <Label Style="{StaticResource Caption}" Text="{Binding SelectedAppointment.TrackingCode}" />
                        <Label Style="{StaticResource Caption}" Text="{Binding SelectedAppointment.PaymentStatus}" />
                        <Label Style="{StaticResource Caption}" Text="{Binding SelectedAppointment.Notes}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <ScrollView IsVisible="{Binding IsSpendingSummaryVisible}">
            <VerticalStackLayout Padding="20" Spacing="12">
                <profile:ProfileHeaderView Title="خلاصه هزینه‌ها" BackCommand="{Binding GoBackCommand}" />
                <profile:ProfileKpiCard
                    Title="جمع هزینه خدمات تکمیل‌شده"
                    Detail="نمایش آزمایشی"
                    Value="{Binding TotalSpending}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource Caption}" Text="پرداخت‌ها بر اساس نوبت‌های تکمیل‌شده محاسبه می‌شوند." />
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static model:ProfileScreen.AppointmentHistory}"
                            Style="{StaticResource Primary}"
                            Text="مشاهده تاریخچه" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <ScrollView IsVisible="{Binding IsFavoritesVisible}">
            <VerticalStackLayout Padding="20" Spacing="12">
                <profile:ProfileHeaderView Title="سالن‌های مورد علاقه" BackCommand="{Binding GoBackCommand}" />
                <CollectionView HeightRequest="500" ItemsSource="{Binding Favorites}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:FavoriteSalonDto">
                            <Border Margin="0,4" Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout>
                                        <Label
                                            FontAttributes="Bold"
                                            FontFamily="Sans"
                                            Text="{Binding Name}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Area}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Rating, StringFormat='امتیاز {0}'}" />
                                    </VerticalStackLayout>
                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.ToggleFavoriteCommand}"
                                        CommandParameter="{Binding Id}"
                                        FontSize="20"
                                        Text="♥"
                                        TextColor="#ED5F91" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <profile:ProfileStateView
                            Title="مورد علاقه‌ای ندارید"
                            Icon="♡"
                            Message="سالن‌های ذخیره‌شده اینجا دیده می‌شوند." />
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <ScrollView IsVisible="{Binding IsAboutVisible}">
            <VerticalStackLayout Padding="20" Spacing="12">
                <profile:ProfileHeaderView Title="درباره Beauty" BackCommand="{Binding GoBackCommand}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontFamily="Sans"
                            FontSize="19"
                            Text="BeautySalonBooking"
                            TextColor="#D94B7D" />
                        <Label Style="{StaticResource Caption}" Text="نسخه ۱.۰" />
                        <Label FontFamily="Sans" Text="سامانه رزرو نوبت سالن‌های زیبایی" />
                        <Label Style="{StaticResource Caption}" Text="تمام داده‌های این بخش در حالت نمایشی محلی نگهداری می‌شوند." />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        
        <Grid BackgroundColor="#80FFFFFF" IsVisible="{Binding IsBusy}">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="True"
                VerticalOptions="Center"
                Color="#ED5F91" />
        </Grid>
        <Border
            Margin="16"
            Padding="10"
            Background="#FFF0F1"
            IsVisible="{Binding HasError}"
            Stroke="#F6CDD1"
            VerticalOptions="End">
            <Label
                FontFamily="Sans"
                FontSize="12"
                Text="{Binding ErrorMessage}"
                TextColor="#D64550" />
        </Border>
        <Border
            Margin="16,16,16,64"
            Padding="10"
            Background="#EAF4EC"
            IsVisible="{Binding HasSuccess}"
            Stroke="#CBE6D2"
            VerticalOptions="End">
            <Label
                FontFamily="Sans"
                FontSize="12"
                Text="{Binding SuccessMessage}"
                TextColor="#23865B" />
        </Border>-->

    </Grid>
</ContentView>
