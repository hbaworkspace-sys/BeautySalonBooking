<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BeautySalonBooking.Maui.Features.Profile.Views.DeleteAccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nav="clr-namespace:BeautySalonBooking.Maui.Components.Navigation"
    xmlns:vm="clr-namespace:BeautySalonBooking.Maui.Features.Profile.ViewModels"
    x:DataType="vm:DeleteAccountViewModel"
    BackgroundColor="#FAF8FA"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <nav:NavigationHeaderView
            Title="حذف حساب"
            Grid.Row="0"
            BackCommand="{Binding GoBackCommand}"
            IsBackEnabled="True"
            IsBackVisible="True" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">

            <VerticalStackLayout Padding="20,18,20,30" Spacing="18">

                <!--  Warning Header  -->

                <Border
                    Padding="20"
                    BackgroundColor="#FFF1F2"
                    Stroke="#F5D1D5"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="1">

                    <VerticalStackLayout HorizontalOptions="Center" Spacing="12">

                        <Border
                            Padding="13"
                            BackgroundColor="#FDE0E3"
                            HeightRequest="62"
                            StrokeShape="RoundRectangle 31"
                            StrokeThickness="0"
                            WidthRequest="62">

                            <Label
                                FontAttributes="Bold"
                                FontSize="27"
                                HorizontalTextAlignment="Center"
                                Text="!"
                                TextColor="#D64550"
                                VerticalTextAlignment="Center" />
                        </Border>

                        <Label
                            FontAttributes="Bold"
                            FontFamily="Sans"
                            FontSize="22"
                            HorizontalTextAlignment="Center"
                            Text="حذف حساب کاربری"
                            TextColor="#29242A" />

                        <Label
                            FontFamily="Sans"
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Text="آیا مطمئن هستید؟ این عملیات قابل بازگشت نیست."
                            TextColor="#786F75" />

                    </VerticalStackLayout>

                </Border>


                <!--  Description  -->

                <Label
                    FontAttributes="Bold"
                    FontFamily="Sans"
                    FontSize="17"
                    Text="با حذف حساب، موارد زیر از بین می‌رود:"
                    TextColor="#29242A" />


                <!--  Deleted Data  -->

                <Border
                    Padding="16"
                    BackgroundColor="White"
                    Stroke="#EEE6EB"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1">

                    <VerticalStackLayout Spacing="15">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border
                                Padding="8"
                                BackgroundColor="#F7F2F4"
                                HeightRequest="34"
                                StrokeShape="RoundRectangle 17"
                                StrokeThickness="0"
                                WidthRequest="34">

                                <Label
                                    FontSize="16"
                                    HorizontalTextAlignment="Center"
                                    Text="✓"
                                    TextColor="#D94B7D"
                                    VerticalTextAlignment="Center" />
                            </Border>

                            <Label
                                Grid.Column="1"
                                FontFamily="Sans"
                                Text="تمام نوبت‌های ثبت‌شده"
                                TextColor="#4D474C"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3EDF1" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border
                                Padding="8"
                                BackgroundColor="#F7F2F4"
                                HeightRequest="34"
                                StrokeShape="RoundRectangle 17"
                                StrokeThickness="0"
                                WidthRequest="34">

                                <Label
                                    FontSize="16"
                                    HorizontalTextAlignment="Center"
                                    Text="✓"
                                    TextColor="#D94B7D"
                                    VerticalTextAlignment="Center" />
                            </Border>

                            <Label
                                Grid.Column="1"
                                FontFamily="Sans"
                                Text="تاریخچه و اطلاعات شخصی"
                                TextColor="#4D474C"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3EDF1" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border
                                Padding="8"
                                BackgroundColor="#F7F2F4"
                                HeightRequest="34"
                                StrokeShape="RoundRectangle 17"
                                StrokeThickness="0"
                                WidthRequest="34">

                                <Label
                                    FontSize="16"
                                    HorizontalTextAlignment="Center"
                                    Text="✓"
                                    TextColor="#D94B7D"
                                    VerticalTextAlignment="Center" />
                            </Border>

                            <Label
                                Grid.Column="1"
                                FontFamily="Sans"
                                Text="سالن‌های مورد علاقه"
                                TextColor="#4D474C"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3EDF1" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border
                                Padding="8"
                                BackgroundColor="#F7F2F4"
                                HeightRequest="34"
                                StrokeShape="RoundRectangle 17"
                                StrokeThickness="0"
                                WidthRequest="34">

                                <Label
                                    FontSize="16"
                                    HorizontalTextAlignment="Center"
                                    Text="✓"
                                    TextColor="#D94B7D"
                                    VerticalTextAlignment="Center" />
                            </Border>

                            <Label
                                Grid.Column="1"
                                FontFamily="Sans"
                                Text="دسترسی به حساب کاربری"
                                TextColor="#4D474C"
                                VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!--  Confirmation  -->

                <Border
                    Padding="16"
                    BackgroundColor="#FFF8FA"
                    Stroke="#F0DDE4"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            FontAttributes="Bold"
                            FontFamily="Sans"
                            Text="تأیید حذف"
                            TextColor="#29242A" />

                        <Label Style="{StaticResource Caption}" Text="برای ادامه، عبارت «حذف» را وارد کنید." />

                        <Entry
                            Margin="0,5,0,0"
                            Placeholder="حذف"
                            Style="{StaticResource Field}"
                            Text="{Binding DeleteConfirmationText}" />

                        <Label
                            FontFamily="Sans"
                            FontSize="12"
                            IsVisible="{Binding HasError}"
                            Text="{Binding ErrorMessage}"
                            TextColor="#D64550" />

                    </VerticalStackLayout>

                </Border>


                <!--  Actions  -->

                <Button
                    BackgroundColor="#D64550"
                    Command="{Binding DeleteAccountCommand}"
                    CornerRadius="15"
                    FontAttributes="Bold"
                    FontFamily="Sans"
                    HeightRequest="52"
                    IsEnabled="{Binding CanDeleteAccount}"
                    Text="ادامه برای حذف حساب"
                    TextColor="White" />

                <Button
                    BackgroundColor="Transparent"
                    Command="{Binding GoBackCommand}"
                    FontAttributes="Bold"
                    FontFamily="Sans"
                    HeightRequest="48"
                    Text="انصراف و بازگشت"
                    TextColor="#D94B7D" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>