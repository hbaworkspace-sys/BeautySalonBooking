<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BeautySalonBooking.Maui.Features.Profile.Views.DeleteAccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:btn="clr-namespace:BeautySalonBooking.Maui.Components.Button"
    xmlns:nav="clr-namespace:BeautySalonBooking.Maui.Components.Navigation"
    xmlns:vm="clr-namespace:BeautySalonBooking.Maui.Features.Profile.ViewModels"
    x:DataType="vm:DeleteAccountViewModel"
    BackgroundColor="#FAF8FA"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <nav:NavigationHeaderView
            Title="حذف حساب کاربری"
            Grid.Row="0"
            BackCommand="{Binding GoBackCommand}"
            IsBackEnabled="True"
            IsBackVisible="True" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">

            <VerticalStackLayout Padding="20,18,20,30" Spacing="18">

                <Border Padding="20" StrokeThickness="0">

                    <VerticalStackLayout HorizontalOptions="Center" Spacing="12">

                        <Border
                            Padding="13"
                            BackgroundColor="#77FDE0E3"
                            HeightRequest="62"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="0"
                            WidthRequest="62">

                            <Label
                                Style="{x:StaticResource GlyphLable}"
                                Text="warning"
                                TextColor="#D64550" />

                        </Border>

                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalTextAlignment="Center"
                            Text="آیا مطمئن هستید؟"
                            TextColor="#29242A" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    Padding="13,10"
                    BackgroundColor="#77FDE0E3"
                    Stroke="#bbD64550"
                    StrokeShape="RoundRectangle 15"
                    StrokeThickness="1">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="با حذف حساب، موارد زیر از بین می‌رود:"
                            TextColor="#D64550" />

                        <HorizontalStackLayout Spacing="10">

                            <Label
                                HorizontalTextAlignment="Center"
                                Text="✘"
                                TextColor="#D94B7D"
                                VerticalTextAlignment="Center" />


                            <Label
                                FontSize="13"
                                Text="تمام نوبت‌های ثبت‌شده"
                                TextColor="#4D474C"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">

                            <Label
                                HorizontalTextAlignment="Center"
                                Text="✘"
                                TextColor="#D94B7D"
                                VerticalTextAlignment="Center" />


                            <Label
                                FontSize="13"
                                Text="تاریخچه و اطلاعات شخصی"
                                TextColor="#4D474C"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">

                            <Label
                                HorizontalTextAlignment="Center"
                                Text="✘"
                                TextColor="#D94B7D"
                                VerticalTextAlignment="Center" />


                            <Label
                                FontSize="13"
                                Text="سالن‌های مورد علاقه"
                                TextColor="#4D474C"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">

                            <Label
                                HorizontalTextAlignment="Center"
                                Text="✘"
                                TextColor="#D94B7D"
                                VerticalTextAlignment="Center" />


                            <Label
                                FontSize="13"
                                Text="دسترسی به حساب کاربری"
                                TextColor="#4D474C"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <btn:PrimaryButtonView Title="ادامه برای حذف حساب" Command="{Binding GoToDeleteAccountConfirmationCommand}" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>