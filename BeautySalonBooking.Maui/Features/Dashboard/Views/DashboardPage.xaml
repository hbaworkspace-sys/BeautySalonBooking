<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BeautySalonBooking.Maui.Features.Dashboard.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:card="clr-namespace:BeautySalonBooking.Maui.Components.Card"
    xmlns:header="clr-namespace:BeautySalonBooking.Maui.Components.Header"
    xmlns:icon="clr-namespace:BeautySalonBooking.Maui.Resources"
    xmlns:media="clr-namespace:BeautySalonBooking.Maui.Components.Media"
    xmlns:nav="clr-namespace:BeautySalonBooking.Maui.Components.Navigation"
    xmlns:shared="clr-namespace:BeautySalonBooking.Maui.Components.Shared"
    xmlns:uc="clr-namespace:BeautySalonBooking.Maui.UserControls"
    xmlns:vm="clr-namespace:BeautySalonBooking.Maui.Features.Dashboard.ViewModels"
    x:DataType="vm:DashboardViewModel"
    BackgroundColor="{x:StaticResource White}"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False">

    <Grid Background="Transparent" RowDefinitions="*,90">
        <ScrollView
            Grid.Row="0"
            Grid.RowSpan="2"
            Margin="10,10,10,0"
            Background="Transparent"
            VerticalScrollBarVisibility="Never">

            <Grid RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto" RowSpacing="15">

                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="75,*,40"
                    ColumnSpacing="3">
                    <Border
                        Grid.Column="0"
                        HeightRequest="50"
                        Style="{x:StaticResource CardBorderStyle}">
                        <Grid
                            Padding="4"
                            ColumnDefinitions="13,*,13"
                            ColumnSpacing="2">
                            <Label
                                Grid.Column="0"
                                FontSize="16"
                                Style="{StaticResource GlyphLable}"
                                Text="{x:Static icon:IconSymbols.KeyboardArrowDown}"
                                TextColor="Black" />
                            <Label
                                Grid.Column="1"
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                Text="تهران" />
                            <Image Grid.Column="2" Source="location.png" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="5"
                        HeightRequest="50"
                        Style="{x:StaticResource CardBorderStyle}">
                        <Grid ColumnDefinitions="*,20">
                            <Label
                                Grid.Column="0"
                                FontSize="10"
                                HorizontalOptions="Center"
                                Text="جستجوی سالن ها، خدمات، آرایشگرها ..." />
                            <Label
                                Grid.Column="1"
                                FontFamily="MaterialIcons"
                                FontSize="24"
                                Style="{x:StaticResource GlyphLable}"
                                Text="{x:Static icon:IconSymbols.Search}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="2"
                        HeightRequest="50"
                        Style="{x:StaticResource CardBorderStyle}">
                        <ImageButton Padding="6" Source="bell.png" />
                    </Border>
                </Grid>

                <ScrollView
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal">
                    <HorizontalStackLayout Spacing="5">

                        <media:MediaItemView
                            Title="زیگورات"
                            ImageSource="onboarding_chair.png"
                            Style="{x:StaticResource StoryStyle}" />

                        <media:MediaItemView
                            Title="طره"
                            ImageSource="onboarding_product.png"
                            Style="{x:StaticResource StoryStyle}" />

                        <media:MediaItemView
                            Title="کیمیا"
                            ImageSource="onboarding_chair.png"
                            Style="{x:StaticResource StoryStyle}" />

                        <media:MediaItemView
                            Title="زیگورات"
                            ImageSource="onboarding_chair.png"
                            Style="{x:StaticResource StoryStyle}" />

                        <media:MediaItemView
                            Title="طره"
                            ImageSource="onboarding_product.png"
                            Style="{x:StaticResource StoryStyle}" />

                        <media:MediaItemView
                            Title="کیمیا"
                            ImageSource="onboarding_chair.png"
                            Style="{x:StaticResource StoryStyle}" />

                        <media:MediaItemView
                            Title="زیگورات"
                            ImageSource="onboarding_chair.png"
                            Style="{x:StaticResource StoryStyle}" />

                        <media:MediaItemView
                            Title="طره"
                            ImageSource="onboarding_product.png"
                            Style="{x:StaticResource StoryStyle}" />

                        <media:MediaItemView
                            Title="کیمیا"
                            ImageSource="onboarding_chair.png"
                            Style="{x:StaticResource StoryStyle}" />
                    </HorizontalStackLayout>
                </ScrollView>

                <Border
                    Grid.Row="2"
                    Padding="5"
                    Style="{x:StaticResource CardBorderStyle}">
                    <VerticalStackLayout
                        Grid.Row="3"
                        Padding="0,5,0,0"
                        Spacing="10">
                        <Label FontSize="12" Text="خدمات و لاین های زیبایی" />
                        <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                            <HorizontalStackLayout Spacing="10">
                                <media:MediaItemView
                                    Title="عروس"
                                    ImageSource="bahar.png"
                                    Style="{x:StaticResource IconLabelStyle}" />

                                <media:MediaItemView
                                    Title="میکاپ"
                                    ImageSource="makup.png"
                                    Style="{x:StaticResource IconLabelStyle}" />

                                <media:MediaItemView
                                    Title="عروس"
                                    ImageSource="bahar.png"
                                    Style="{x:StaticResource IconLabelStyle}" />

