                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal">

                    <HorizontalStackLayout Spacing="15">

                        <card:ShowcaseCardView
                            Title="سیب نقره ای"
                            BadgeText="تخفیف 30%"
                            Image="onboarding_product.png"
                            Rating="6.8"
                            Style="{x:StaticResource ShowcaseCardStyle}"
                            Subtitle="سنندج - خ.آبیدر" />

                        <card:ShowcaseCardView
                            Title="نیلوفر آبی"
                            BadgeText="تخفیف 25%"
                            Image="onboarding_chair.png"
                            Rating="9.1"
                            Style="{x:StaticResource ShowcaseCardStyle}"
                            Subtitle="تهران - سعادت آباد" />

                        <card:ShowcaseCardView
                            Title="حنانه"
                            BadgeText="تخفیف 12%"
                            Image="onboarding_mobile.png"
                            Rating="5.4"
                            Style="{x:StaticResource ShowcaseCardStyle}"
                            Subtitle="کرمانشاه - شهرک سعدی" />

