                                    Style="{x:StaticResource IconLabelStyle}" />

                                <media:MediaItemView
                                    Title="میکاپ"
                                    ImageSource="makup.png"
                                    Style="{x:StaticResource IconLabelStyle}" />
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <header:SectionHeaderView
