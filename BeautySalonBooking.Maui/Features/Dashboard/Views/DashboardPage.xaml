                            Image="noroz.png"
                            Subtitle="تا 20٪ تخفیف" />

                        <card:FeatureCardView
                            Title="شب یلدا"
                            Image="yalda.png"
                            Subtitle="تا 15٪ تخفیف" />

                        <card:FeatureCardView
                            Title="روز مادر"
                            Image="mathar.png"
                            Subtitle="تا 35٪ تخفیف" />

                    </HorizontalStackLayout>
                </ScrollView>
            </Grid>

        </ScrollView>

        <nav:TabBar
            x:Name="MainTabBar"
            Grid.Row="1"
            Margin="10,10"
            BorderBrush="Pink"
            BorderWidth="2"
            CornerRadius="18"
            FillBrush="White"
            HorizontalOptions="Fill"
            Placement="Bottom"
            SelectedIndex="2"
            VerticalOptions="Fill">
            <nav:TabBar.Items>

                <nav:TabItemView
                    BadgeBackground="#fc6c85"
                    BadgeMargin="0,0,8,0"
                    BadgeText="26"
                    IconMode="Glyph"
                    IsBadgeVisible="True"
                    NormalIcon="{x:Static icon:IconFont.Message}"
                    Style="{x:StaticResource BottomTabItemStyle}"
                    Text="پیام‌ها" />

                <nav:TabItemView
                    IconMode="Glyph"
                    NormalIcon="{x:Static icon:IconFont.Search}"
                    Style="{x:StaticResource BottomTabItemStyle}"
                    Text="جستجو" />

                <nav:TabItemView
