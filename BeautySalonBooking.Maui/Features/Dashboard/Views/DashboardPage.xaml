                <ScrollView
                    Grid.Row="6"
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal">

                    <HorizontalStackLayout Spacing="6">

                        <card:FeatureCardView
                            Title="شب کریسمس"
                            Image="kris.png"
                            Subtitle="تا 60٪ تخفیف" />

                        <card:FeatureCardView
