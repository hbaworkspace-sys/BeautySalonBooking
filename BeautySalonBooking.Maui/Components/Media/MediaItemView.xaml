<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.Components.Media.MediaItemView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:media="clr-namespace:BeautySalonBooking.Maui.Components.Media"
    x:Name="self">

    <VerticalStackLayout x:Name="RootLayout" HorizontalOptions="Center">

        <VerticalStackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference self}}" CommandParameter="{Binding CommandParameter, Source={x:Reference self}}" />
        </VerticalStackLayout.GestureRecognizers>

        <media:MediaView x:Name="Media" />

        <Label
            x:Name="TitleLabel"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            LineBreakMode="TailTruncation" />

    </VerticalStackLayout>
</ContentView>