<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.Components.Navigation.NavigationHeaderView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ContentView.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="FontFamily" Value="MaterialIconsOut" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="WidthRequest" Value="40" />
        </Style>
    </ContentView.Resources>

    <Grid
        Padding="15,18,15,8"
        ColumnDefinitions="40,*,40"
        HorizontalOptions="Fill"
        VerticalOptions="Center">

        <Button x:Name="NextButton" Grid.Column="0" />

        <Label
            x:Name="TitleLabel"
            Grid.Column="1"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <Button x:Name="BackButton" Grid.Column="2" />
    </Grid>

</ContentView>
