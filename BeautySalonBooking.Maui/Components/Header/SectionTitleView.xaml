<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.Components.Header.SectionTitleView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid
        x:Name="Container"
        ColumnDefinitions="Auto,*"
        ColumnSpacing="8">

        <Label
            x:Name="TitleLabel"
            Grid.Column="0"
            FontAttributes="Bold"
            FontSize="14"
            HorizontalTextAlignment="End"
            TextColor="Black"
            VerticalOptions="Center" />

        <BoxView
            x:Name="Divider"
            Grid.Column="1"
            BackgroundColor="#EA6A96"
            HeightRequest="2"
            Opacity="0.35"
            VerticalOptions="Center" />

    </Grid>
</ContentView>
