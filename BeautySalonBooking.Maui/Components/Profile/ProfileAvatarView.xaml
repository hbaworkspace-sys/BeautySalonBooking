<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.Components.Profile.ProfileAvatarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shared="clr-namespace:BeautySalonBooking.Maui.Components.Shared"
    x:Name="self">

    <Grid>
        <Border
            x:Name="AvatarBorder"
            Background="#FFF0F5"
            HeightRequest="76"
            Stroke="#EA6A96"
            StrokeThickness="2"
            WidthRequest="76">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Grid Padding="3">
                <Label
                    x:Name="InitialsLabel"
                    FontAttributes="Bold"
                    FontFamily="Sans"
                    FontSize="22"
                    HorizontalOptions="Center"
                    TextColor="#D94B7D"
                    VerticalOptions="Center" />
                <Image
                    x:Name="AvatarImage"
                    Margin="-5"
                    Aspect="Fill" />
            </Grid>
        </Border>
        <shared:ActionIconView
            Margin="-5"
            BorderBrush="White"
            BorderWidth="1.5"
            CornerRadius="25"
            FillBrush="#EA6A96"
            HorizontalOptions="End"
            Icon="photo_camera"
            IconColor="White"
            IconSize="16"
            TouchSize="25"
            VerticalOptions="End" />
    </Grid>
</ContentView>
