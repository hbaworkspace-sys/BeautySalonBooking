<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.Components.Profile.ProfileHeaderView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="root">
    <Grid Padding="0,4" ColumnDefinitions="Auto,*,Auto">
        <Button
            BackgroundColor="Transparent"
            Command="{Binding BackCommand, Source={x:Reference root}}"
            FontSize="28"
            Text="‹"
            TextColor="#D94B7D" />
        <Label
            x:Name="TitleLabel"
            Grid.Column="1"
            FontAttributes="Bold"
            FontFamily="Sans"
            FontSize="20"
            TextColor="#29242A"
            VerticalOptions="Center" />
        <Label
            x:Name="ActionLabel"
            Grid.Column="2"
            FontFamily="Sans"
            FontSize="12"
            TextColor="#D94B7D"
            VerticalOptions="Center" />
    </Grid>
</ContentView>
