<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.Components.Profile.ProfileStateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="root">
    <VerticalStackLayout
        Padding="28"
        HorizontalOptions="Center"
        Spacing="8"
        VerticalOptions="Center">
        <Label
            x:Name="IconLabel"
            FontSize="28"
            HorizontalTextAlignment="Center"
            TextColor="#ED5F91" />
        <Label
            x:Name="TitleLabel"
            FontAttributes="Bold"
            FontFamily="Sans"
            HorizontalTextAlignment="Center"
            TextColor="#29242A" />
        <Label
            x:Name="MessageLabel"
            FontFamily="Sans"
            FontSize="12"
            HorizontalTextAlignment="Center"
            TextColor="#77717A" />
        <Button
            x:Name="ActionButton"
            BackgroundColor="#ED5F91"
            CornerRadius="14"
            FontFamily="Sans"
            IsVisible="False"
            TextColor="White" />
    </VerticalStackLayout>
</ContentView>
