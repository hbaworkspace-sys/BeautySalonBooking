<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.Components.Profile.SettingsRowView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="root">

    <Grid
        Padding="16,13"
        ColumnDefinitions="auto,*,Auto,20"
        ColumnSpacing="10"
        HeightRequest="60">
        <Border
            x:Name="IconContainer"
            Grid.Column="0"
            HeightRequest="32"
            StrokeThickness="0"
            WidthRequest="32">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Label
                x:Name="IconLabel"
                FontSize="22"
                Style="{StaticResource GlyphLable}" />
        </Border>
        <VerticalStackLayout
            Grid.Column="1"
            Spacing="2"
            VerticalOptions="Center">
            <Label
                x:Name="TitleLabel"
                FontAttributes="Bold"
                FontSize="12"
                TextColor="#111111" />
            <Label
                x:Name="DescriptionLabel"
                FontSize="11"
                IsVisible="False"
                TextColor="#77717A" />
        </VerticalStackLayout>
        <Label
            x:Name="ValueLabel"
            Grid.Column="2"
            FontSize="11"
            TextColor="#77717A"
            VerticalOptions="Center" />
        <Label
            x:Name="ActionTitleLable"
            Grid.Column="3"
            FontSize="24"
            Text="‹"
            TextColor="Gray"
            VerticalOptions="Center" />
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference root}}" CommandParameter="{Binding CommandParameter, Source={x:Reference root}}" />
        </Grid.GestureRecognizers>
    </Grid>
</ContentView>
