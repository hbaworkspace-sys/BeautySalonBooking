<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.Components.Profile.ProfileKpiCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="root">
    <Border
        Padding="14"
        Background="White"
        Stroke="#EEE8ED"
        StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="18" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="3">
            <Border
                Background="#fff0f5"
                HeightRequest="30"
                HorizontalOptions="Start"
                WidthRequest="30">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Label
                    x:Name="DetailLabel"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Style="{StaticResource GlyphLable}"
                    VerticalOptions="Center" />
            </Border>
            <Label
                x:Name="ValueLabel"
                FontAttributes="Bold"
                FontFamily="Sans"
                FontSize="15"
                TextColor="#29242A" />
            <Label
                x:Name="TitleLabel"
                FontAttributes="Bold"
                FontSize="11"
                TextColor="#222222" />
        </VerticalStackLayout>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference root}}" CommandParameter="{Binding CommandParameter, Source={x:Reference root}}" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
