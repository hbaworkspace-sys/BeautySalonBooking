<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="BeautySalonBooking.Maui.Components.Indicator.LoadingIndicator"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid>

        <!--  Overlay  -->
        <Border x:Name="OverlayBorder" InputTransparent="False">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>

            <Grid HorizontalOptions="Center" VerticalOptions="Center">

                <VerticalStackLayout
                    x:Name="LoadingContainer"
                    HorizontalOptions="Center"
                    Spacing="12"
                    VerticalOptions="Center">

                    <!--  Loading Spinner  -->
                    <ActivityIndicator
                        x:Name="LoadingIndicatorView"
                        HorizontalOptions="Center"
                        IsRunning="True"
                        VerticalOptions="Center" />

                    <!--  Loading Message  -->
                    <Label
                        x:Name="MessageLabel"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        VerticalOptions="Center" />

                </VerticalStackLayout>

            </Grid>

        </Border>

    </Grid>

</ContentView>