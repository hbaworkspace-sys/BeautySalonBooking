<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.Components.DateAndTime.DateItemView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        x:Name="ContainerBorder"
        Padding="12,8"
        BackgroundColor="White"
        Stroke="#E8E1E5"
        WidthRequest="65">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="4">

            <Label
                x:Name="DayNameLabel"
                FontSize="9"
                HorizontalTextAlignment="Center"
                TextColor="#6F666B" />

            <Label
                x:Name="DayNumberLabel"
                FontAttributes="Bold"
                FontSize="14"
                HorizontalTextAlignment="Center"
                TextColor="#292329" />

            <Label
                x:Name="MonthNameLabel"
                FontSize="8"
                HorizontalTextAlignment="Center"
                TextColor="#8F858A" />

        </VerticalStackLayout>

    </Border>


</ContentView>
