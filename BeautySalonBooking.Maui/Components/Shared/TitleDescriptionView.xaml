<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="BeautySalonBooking.Maui.Components.Shared.TitleDescriptionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout x:Name="Container">
        <Label
            x:Name="TitleLabel"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center" />

        <Label x:Name="DescriptionLabel" HorizontalTextAlignment="Center" />

    </VerticalStackLayout>

</ContentView>