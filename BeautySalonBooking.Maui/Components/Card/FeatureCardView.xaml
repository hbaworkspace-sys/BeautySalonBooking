<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.Components.Card.FeatureCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border x:Name="ContainerBorder" StrokeThickness="0">
        <Border.StrokeShape>
            <RoundRectangle x:Name="CardShape" />
        </Border.StrokeShape>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="*,*">

            <!--  Image  -->
            <Image
                x:Name="ImageView"
                Grid.RowSpan="2"
                Aspect="AspectFill" />

            <!--  Overlay  -->
            <BoxView
                x:Name="OverlayView"
                Grid.RowSpan="2"
                IsVisible="False" />

            <!--  Content  -->
            <VerticalStackLayout
                x:Name="ContentLayout"
                Grid.Row="1"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Label
                    x:Name="TitleLabel"
                    FontAttributes="Bold"
                    FontSize="13"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="SubtitleLabel"
                    FontSize="11"
                    HorizontalTextAlignment="Center"
                    TextColor="Gray" />

                <Border x:Name="ActionBorder" Padding="8,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnActionTapped" />
                    </Border.GestureRecognizers>

                    <Label
                        x:Name="ActionLabel"
                        FontSize="12"
                        HorizontalOptions="Center"
                        TextColor="White" />
                </Border>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>