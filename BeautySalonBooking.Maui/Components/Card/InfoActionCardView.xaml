<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.Components.Card.InfoActionCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        x:Name="CardBorder"
        Padding="10"
        StrokeShape="RoundRectangle 18"
        StrokeThickness="1">

        <Grid ColumnDefinitions="auto,*" ColumnSpacing="10">

            <Label
                x:Name="IconLable"
                Grid.Column="0"
                Style="{x:StaticResource GlyphLable}" />

            <Grid
                Grid.Column="1"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12"
                RowDefinitions="Auto,Auto"
                RowSpacing="6">

                <VerticalStackLayout
                    x:Name="ContentLayout"
                    Grid.Row="0"
                    Spacing="5"
                    VerticalOptions="Center">

                    <Label
                        x:Name="TitleLabel"
                        FontAttributes="Bold"
                        FontSize="13" />

                    <Label
                        x:Name="DescriptionLabel"
                        FontSize="12"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

                <Border
                    x:Name="StatusBorder"
                    Grid.Column="1"
                    Padding="10,5"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    VerticalOptions="Start">

                    <Label
                        x:Name="StatusLabel"
                        FontAttributes="Bold"
                        FontSize="12" />

                </Border>

                <Button
                    x:Name="ActionButton"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Padding="0"
                    Background="Transparent"
                    FontAttributes="Bold"
                    FontFamily="Sans"
                    FontSize="13"
                    VerticalOptions="Center" />

            </Grid>

        </Grid>
    </Border>

</ContentView>