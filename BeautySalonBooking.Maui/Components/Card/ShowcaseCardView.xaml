<ContentView
    x:Class="BeautySalonBooking.Maui.Components.Card.ShowcaseCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:card="clr-namespace:BeautySalonBooking.Maui.Components.Card"
    xmlns:shared="clr-namespace:BeautySalonBooking.Maui.Components.Shared">

    <Border x:Name="ContainerBorder" StrokeThickness="0">

        <Border.StrokeShape>
            <RoundRectangle x:Name="CardShape" />
        </Border.StrokeShape>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="*,*">

            <!--  Background Image  -->
            <Image
                x:Name="BackgroundImageView"
                Grid.RowSpan="2"
                Aspect="AspectFill" />

            <!--  Main Image  -->
            <Image
                x:Name="ImageView"
                Grid.Row="0"
                Aspect="AspectFill"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <!--  Image Overlay  -->
            <BoxView
                x:Name="ImageOverlay"
                Grid.Row="0"
                IsVisible="False" />

            <!--  Top Actions  -->
            <Grid
                x:Name="TopActionLayout"
                Grid.Row="0"
                Padding="0"
                ColumnDefinitions="auto,*"
                HorizontalOptions="Fill"
                VerticalOptions="Start">

                <!--  Discount / Featured / New ...  -->
                <shared:BadgeView
                    x:Name="BadgeView"
                    Grid.Column="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Start" />

                <!--  Favorite  -->
                <shared:ActionIconView
                    x:Name="FavoriteAction"
                    Grid.Column="1"
                    Margin="0,-3,0,0"
                    HorizontalOptions="End"
                    VerticalOptions="Start" />
            </Grid>

            <!--  Bottom Information  -->
            <Grid
                x:Name="InformationLayout"
                Grid.Row="1"
                RowDefinitions="*,*,auto">

                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="auto,*"
                    ColumnSpacing="5">

                    <!--  Bookmark  -->
                    <shared:ActionIconView
                        x:Name="BookmarkAction"
                        Grid.Column="0"
                        Margin="-2,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" />

                    <!--  Title  -->
                    <Label
                        x:Name="TitleLabel"
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="12"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" />
                </Grid>

                <!--  Subtitle  -->
                <Label
                    x:Name="SubtitleLable"
                    Grid.Row="1"
                    Margin="5,0,0,0"
                    FontSize="10"
                    HorizontalOptions="Start"
                    VerticalOptions="Start" />

                <Grid
                    x:Name="MetadataLayout"
                    Grid.Row="2"
                    Padding="4,0"
                    ColumnDefinitions="Auto,Auto"
                    ColumnSpacing="5"
                    HorizontalOptions="Start"
                    VerticalOptions="End">

                    <Label
                        x:Name="RatingIconLabel"
                        Grid.Column="0"
                        FontSize="13"
                        Text="⭐" />

                    <Label
                        x:Name="RatingLabel"
                        Grid.Column="1"
                        FontSize="11" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ContentView>