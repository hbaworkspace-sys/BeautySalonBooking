<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.UserControls.TextLink"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="self">
    <Grid ColumnDefinitions="auto,auto" ColumnSpacing="5">

        <Label
            Grid.Column="0"
            FontSize="12"
            Text="{Binding QuestionText, Source={x:Reference self}}" />

        <Label
            Grid.Column="1"
            FontSize="12"
            Text="{Binding Text, Source={x:Reference self}}"
            TextColor="#F05C80" />

        <Button
            Grid.Column="1"
            BackgroundColor="Transparent"
            Clicked="Button_Clicked"
            Command="{Binding HCommand, Source={x:Reference self}}" />

        <BoxView
            x:Name="UnderLineBox"
            Grid.Column="1"
            Margin="0,12,0,0"
            BackgroundColor="#F05C80"
            HeightRequest="1.5"
            IsVisible="False" />
    </Grid>
</ContentView>
