<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeautySalonBooking.Maui.UserControls.TextLink"
             x:Name="self">
    <Grid>
        <Button
            Background="Transparent"
            x:Name="Button"
            HeightRequest="45"
            FontFamily="BHoma"
            HorizontalOptions="Center"
            Text="{Binding Text,Source={x:Reference self}}"
            Clicked="Button_Clicked"
            TextColor="{x:StaticResource Black}"
            Command="{Binding HCommand, Source={x:Reference self}}"/>

        <BoxView
            x:Name="UnderLineBox"
            HeightRequest="1.5"
            Margin="0,12,0,0"
            BackgroundColor="DarkCyan"
            IsVisible="False"/>
    </Grid>
</ContentView>
