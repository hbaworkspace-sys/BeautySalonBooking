<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeautySalonBooking.Maui.UserControls.ButtonControl.NextAndBackButtonView"
             xmlns:icon="clr-namespace:BeautySalonBooking.Maui.Resources"
             x:Name="self">

    <ContentView.Resources>
        <Style TargetType="Button">
            <Setter Property="BorderWidth" Value="0"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="FontSize" Value="35"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontFamily" Value="MaterialIconsOut"/>
            <Setter Property="HeightRequest" Value="35"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </ContentView.Resources>

    <Grid
        ColumnDefinitions="25,*,25">

        <Button
            Grid.Column="0"
            Text="{x:Static icon:IconSymbols.ChevronForward}"
            IsVisible="{Binding IsNextVisible , Source={x:Reference self}}"
            Command="{Binding NextCommand, Source={x:Reference self}}"
            Clicked="btnNext_Clicked"/>

        <Button
            Grid.Column="2"
            Text="{x:Static icon:IconSymbols.ChevronBackward}"
            IsVisible="{Binding IsBackVisible, Source={x:Reference self}}"
            Command="{Binding BackCommand, Source={x:Reference self}}"
            Clicked="btnBack_Clicked"/>
    </Grid>
</ContentView>