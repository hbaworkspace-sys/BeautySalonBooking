<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.UserControls.Indicators.SimpleIndicator"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid
        ColumnDefinitions="*,*,*"
        ColumnSpacing="3"
        HeightRequest="6"
        WidthRequest="150">
        <Border
            x:Name="Indicator_Border1"
            Grid.Column="0"
            Background="LightGray"
            StrokeShape="RoundRectangle 50"
            StrokeThickness="0" />
        <Border
            x:Name="Indicator_Border2"
            Grid.Column="1"
            Background="LightGray"
            StrokeShape="RoundRectangle 50"
            StrokeThickness="0" />
        <Border
            x:Name="Indicator_Border3"
            Grid.Column="2"
            Background="LightGray"
            StrokeShape="RoundRectangle 50"
            StrokeThickness="0" />
    </Grid>
</ContentView>