<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeautySalonBooking.Maui.UserControls.IndicatorsControl.SimpleIndicator">
    <Grid
        WidthRequest="150"
        HeightRequest="6"
        ColumnDefinitions="*,*,*"
        ColumnSpacing="3">
        <Border
            x:Name="Indicator_Border1"
            StrokeThickness="0"
            Background="LightGray"
            Grid.Column="0"
            StrokeShape="RoundRectangle 50">
        </Border>
        <Border
            x:Name="Indicator_Border2"
            StrokeThickness="0"
            Background="LightGray"
            Grid.Column="1"
            StrokeShape="RoundRectangle 50">
        </Border>
        <Border
            x:Name="Indicator_Border3"
            StrokeThickness="0"
            Background="LightGray"
            Grid.Column="2"
            StrokeShape="RoundRectangle 50">
        </Border>
    </Grid>
</ContentView>