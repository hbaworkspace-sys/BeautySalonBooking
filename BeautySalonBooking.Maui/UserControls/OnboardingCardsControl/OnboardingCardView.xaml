<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeautySalonBooking.Maui.UserControls.OnboardingCard.OnboardingCardView"
             xmlns:ucImg="clr-namespace:BeautySalonBooking.Maui.UserControls.Images"
             xmlns:uc="clr-namespace:BeautySalonBooking.Maui.UserControls"
             BackgroundColor="{x:StaticResource White}">

    <Grid
        RowDefinitions="380,*,70">

        <Image
            x:Name="imgMainBox"
            Grid.Row="0"
            Aspect="Fill"/>

        <ucImg:CircularContentView
            x:Name="imgCircularIcon"
            Grid.Row="0"
            Size="Medium"
            Margin="0,0,0,-250"/>

        <uc:TitleSubtitleView
            Grid.Row="1"
            VerticalOptions="Center"
            x:Name="textContent"/>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="70,*,70">

            <Button
                x:Name="btnBack"
                Grid.Column="2"
                BackgroundColor="Transparent"
                Text="Back"
                TextColor="#777777"
                Clicked="btnBack_Clicked"/>

            <HorizontalStackLayout
                Grid.Column="1"
                Spacing="8"
                FlowDirection="LeftToRight"
                HorizontalOptions="Center">
                <BoxView
                    x:Name="Indicator_1"
                    WidthRequest="10"
                    HeightRequest="10"
                    Color="PaleVioletRed"
                    CornerRadius="5"/>
                <BoxView
                    x:Name="Indicator_2"
                    WidthRequest="10"
                    HeightRequest="10"
                    Color="LightGray"
                    CornerRadius="5"/>
                <BoxView
                    x:Name="Indicator_3"
                    WidthRequest="10"
                    HeightRequest="10"
                    Color="LightGrey"
                    CornerRadius="5"/>
            </HorizontalStackLayout>

            <Button
                x:Name="btnNext"
                BackgroundColor="Transparent"
                Grid.Column="0"
                Text="Next"
                TextColor="#777777"
                Clicked="btnNext_Clicked"/>
        </Grid>
    </Grid>
</ContentView>