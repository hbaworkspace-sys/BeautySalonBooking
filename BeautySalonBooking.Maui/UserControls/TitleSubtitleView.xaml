<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.UserControls.TitleSubtitleView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="self">

    <VerticalStackLayout Spacing="8">

        <Label Style="{StaticResource PageTitleStyle}" Text="{Binding Title, Source={x:Reference self}}" />

        <Label Style="{StaticResource PageSubtitleStyle}" Text="{Binding Subtitle, Source={x:Reference self}}" />

    </VerticalStackLayout>
</ContentView>