<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeautySalonBooking.Maui.UserControls.UniversalItemPicker"
             x:Name="self"
             Background="Transparent">

    <Border
        x:Name="border"
        Background="{x:StaticResource SecondaryBackground}"
        StrokeThickness="0"
        HeightRequest="45">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="50"/>
        </Border.StrokeShape>

        <Grid
            ColumnDefinitions="30,*">

            <Label
                Margin="10,0,0,0"
                Grid.Column="0"
                Style="{x:StaticResource GlyphLable}"
                Text="{Binding Glyph,Source={x:Reference self}}"/>

            <Label
                x:Name="lblPalceHolder"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Text="{Binding PlaceHolder, Source={x:Reference self}}"
                HorizontalOptions="Center"/>

            <Picker
                x:Name="cmbcombo"
                Grid.Column="1"
                HeightRequest="55"
                FontSize="13"
                FontFamily="BHoma"
                Margin="0,5"
                TextColor="Black"
                Background="Transparent"
                ItemDisplayBinding="{Binding Name}"
                SelectedIndexChanged="cmbcombo_SelectedIndexChanged"
                ItemsSource="{Binding List, Source={Reference self}}"
                SelectedItem="{Binding Selected,Source={Reference self},Mode=TwoWay}"/>
        </Grid>
    </Border>
</ContentView>