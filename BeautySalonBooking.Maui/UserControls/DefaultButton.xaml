<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.UserControls.DefaultButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="self">

    <Border
        Margin="10,0,10,0"
        HeightRequest="50"
        StrokeThickness="0">

        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="1.0" Color="#eefabaac" />
                <GradientStop Offset="0.0" Color="#eef99bd3" />
            </LinearGradientBrush>
        </Border.Background>

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>

        <Button
            Padding="0"
            Background="Transparent"
            Clicked="Button_Clicked"
            Command="{x:Binding HCommand,
                                Source={x:Reference self}}"
            FontFamily="Sans"
            FontSize="18"
            Text="{Binding Title, Source={x:Reference self}}"
            TextColor="{x:StaticResource White}" />

    </Border>
</ContentView>
