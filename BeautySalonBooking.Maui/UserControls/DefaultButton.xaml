<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeautySalonBooking.Maui.UserControls.DefaultButton"
             x:Name="self">

    <Border
        StrokeThickness="0"
        Margin="10,0,10,0"
        HeightRequest="50">

        <Border.Background>
            <LinearGradientBrush
                StartPoint="0,0"
                EndPoint="1,1">
                <GradientStop
                    Color="#eefabaac"
                    Offset="1.0" />
                <GradientStop
                    Color="#eef99bd3"
                    Offset="0.0" />
            </LinearGradientBrush>
        </Border.Background>

        <Border.StrokeShape>
            <RoundRectangle
                CornerRadius="12"/>
        </Border.StrokeShape>

        <Button
            FontSize="18"
            Padding="0"
            TextColor="{x:StaticResource White}"
            Text="{Binding Title,Source={x:Reference self}}"
            Background="Transparent"
            Clicked="Button_Clicked"
            FontFamily="Sans"
            Command="{x:Binding HCommand, Source={x:Reference self}}"/>

    </Border>
</ContentView>
