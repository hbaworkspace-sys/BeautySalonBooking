<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeautySalonBooking.Maui.UserControls.CountdownView"
             x:Name="self">

    <HorizontalStackLayout
        HorizontalOptions="Center"
        Spacing="5">

        <Label
            x:Name="lblTitle"
            Text="{Binding Title, Source={x:Reference self}}"
            FontSize="14"
            TextColor="LightGray"/>

        <Label
            x:Name="lblTimer"
            FontSize="14"
            FontAttributes="Bold"
            TextColor="#ED7F89"/>

        <Label
            x:Name="lblAction"
            Text="{Binding ActionText, Source={x:Reference self}}"
            FontSize="14"
            FontAttributes="Bold"
            IsVisible="False"
            TextColor="#ED7F89">

            <Label.GestureRecognizers>
                <TapGestureRecognizer
                    Tapped="OnActionTapped"/>
            </Label.GestureRecognizers>
        </Label>

    </HorizontalStackLayout>
</ContentView>