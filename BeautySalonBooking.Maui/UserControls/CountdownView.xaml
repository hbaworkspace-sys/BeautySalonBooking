<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeautySalonBooking.Maui.UserControls.CountdownView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="self">

    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">

        <Label
            x:Name="lblTitle"
            FontSize="14"
            Text="{Binding Title, Source={x:Reference self}}"
            TextColor="LightGray" />

        <Label
            x:Name="lblTimer"
            FontAttributes="Bold"
            FontSize="14"
            TextColor="#ED7F89" />

        <Label
            x:Name="lblAction"
            FontAttributes="Bold"
            FontSize="14"
            IsVisible="False"
            Text="{Binding ActionText, Source={x:Reference self}}"
            TextColor="#ED7F89">

            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnActionTapped" />
            </Label.GestureRecognizers>
        </Label>

    </HorizontalStackLayout>
</ContentView>